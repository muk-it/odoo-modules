msgstr "Une page publique liste vos apps et la version d'Odoo"

#. module: muk_check
#: model:muk_check.rule,name:muk_check.rule_modules_failing_crons
msgid "A scheduled action keeps failing"
msgstr "Une action planifiée échoue sans cesse"

#. module: muk_check
#: model:muk_check.rule,name:muk_check.rule_modules_server_actions
msgid "A server action with Python code was added in the database"
msgstr ""
"Une action de serveur avec du code Python a été ajoutée dans la base de "
