<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="after">
                <block title="Security Check" id="check">
                    <setting help="Ask apps.odoo.com and Docker Hub for new versions once a day.">
                        <field name="check_online"/>
                    </setting>
                    <setting help="Post new findings in the Administrators channel.">
                        <field name="check_notifications"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
