<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='integration']" position="after">
                <h2>Security Check</h2>
                <div class="row mt16 o_settings_container" name="check">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="check_online"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="check_online"/>
                            <div class="text-muted">
                                Ask apps.odoo.com and Docker Hub for new versions once a day.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="check_notifications"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="check_notifications"/>
                            <div class="text-muted">
                                Post new findings in the Administrators channel.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
