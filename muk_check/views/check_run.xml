<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_check_run_list" model="ir.ui.view">
        <field name="name">muk_check.run.list</field>
        <field name="model">muk_check.run</field>
        <field name="arch" type="xml">
            <tree js_class="mk_check_list" create="false" edit="false">
                <header>
                    <button
                        name="%(action_check_run_now)d"
                        type="action"
                        string="Run Check"
                        class="btn-primary mk_check_always"
                    />
                </header>
                <field name="create_date" string="Date"/>
                <field
                    name="grade"
                    widget="badge"
                    decoration-success="grade in ('A', 'B')"
                    decoration-warning="grade == 'C'"
                    decoration-danger="grade in ('D', 'F')"
                />
                <field name="score" widget="progressbar"/>
                <field name="critical_count" optional="show"/>
                <field name="high_count" optional="show"/>
                <field name="medium_count" optional="show"/>
                <field name="low_count" optional="show"/>
                <field name="accepted_count" optional="hide"/>
                <field name="passed_count" optional="hide"/>
                <field name="not_applicable_count" optional="hide"/>
                <field name="error_count" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_check_run_graph" model="ir.ui.view">
        <field name="name">muk_check.run.graph</field>
        <field name="model">muk_check.run</field>
        <field name="arch" type="xml">
            <graph string="Score" type="line">
                <field name="create_date" interval="day"/>
                <field name="score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_check_run_form" model="ir.ui.view">
        <field name="name">muk_check.run.form</field>
        <field name="model">muk_check.run</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <header>
                    <button
                        name="%(action_check_run_now)d"
                        type="action"
                        string="Run Check"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
                            name="%(action_check_finding)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-bullseye"
                            context="{'search_default_critical': 1}"
                        >
                            <field
                                name="critical_count"
                                widget="statinfo"
                                string="Critical"
                            />
                        </button>
                        <button
                            name="%(action_check_finding)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-exclamation-triangle"
                            context="{'search_default_high': 1}"
                        >
                            <field name="high_count" widget="statinfo" string="High"/>
                        </button>
                        <button
                            name="%(action_check_finding)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-exclamation-circle"
                            context="{'search_default_medium': 1}"
                        >
                            <field
                                name="medium_count"
                                widget="statinfo"
                                string="Medium"
                            />
                        </button>
                        <button
                            name="%(action_check_finding)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-info-circle"
                            context="{'search_default_low': 1}"
                        >
                            <field name="low_count" widget="statinfo" string="Low"/>
                        </button>
                        <button
                            name="%(action_check_finding)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-check-square-o"
                            context="{'search_default_open': 0, 'search_default_accepted': 1}"
                        >
                            <field
                                name="accepted_count"
                                widget="statinfo"
                                string="Accepted"
                            />
                        </button>
                        <button
                            name="%(action_check_rule)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-check-circle"
                            context="{'search_default_passed': 1}"
                        >
                            <field
                                name="passed_count"
                                widget="statinfo"
                                string="Passed"
                            />
                        </button>
                        <button
                            name="%(action_check_rule)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-ban"
                            context="{'search_default_not_applicable': 1}"
                        >
                            <field
                                name="not_applicable_count"
                                widget="statinfo"
                                string="Not Applicable"
                            />
                        </button>
                        <button
                            name="%(action_check_rule)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-bug"
                            attrs="{'invisible': [('error_count', '=', 0)]}"
                            context="{'search_default_error': 1}"
                        >
                            <field
                                name="error_count"
                                widget="statinfo"
                                string="Errors"
                            />
                        </button>
                    </div>
                    <div class="row g-3 mb-4">
                        <div class="col-auto d-flex align-items-center">
                            <field
                                name="grade"
                                widget="badge"
                                class="mk_check_grade"
                                decoration-success="grade in ('A', 'B')"
                                decoration-warning="grade == 'C'"
                                decoration-danger="grade in ('D', 'F')"
                            />
                        </div>
                        <div class="col col-md">
                            <div class="mk_check_kpi border rounded p-3 h-100">
                                <div class="text-muted mb-1">Score</div>
                                <field name="score" widget="progressbar" class="w-100"/>
                                <div class="small text-muted">
                                    <field name="open_note" class="mk_check_note"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md flex-grow-1">
                            <div class="mk_check_kpi border rounded p-3 h-100">
                                <div class="text-muted mb-1">Last checked</div>
                                <field name="create_date"/>
                                <div
                                    class="small text-muted"
                                    attrs="{'invisible': [('next_check', '=', False)]}"
                                >
                                    Next check
                                    <field name="next_check" class="mk_check_note"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md flex-grow-1">
                            <div class="mk_check_kpi border rounded p-3 h-100">
                                <div class="text-muted mb-1">Current version</div>
                                <field name="odoo_version"/>
                                <field name="odoo_build_late" invisible="1"/>
                                <div
                                    class="d-flex flex-wrap gap-2 small text-muted"
                                    attrs="{'invisible': [('odoo_build', '=', False)]}"
                                >
                                    <div>
                                        Build
                                        <field name="odoo_build" class="mk_check_note"/>
                                    </div>
                                    <field
                                        name="odoo_build_note"
                                        class="mk_check_note"
                                        attrs="{'invisible': [('odoo_build_late', '=', True)]}"
                                    />
                                    <field
                                        name="odoo_build_note"
                                        class="mk_check_note text-warning"
                                        attrs="{'invisible': [('odoo_build_late', '=', False)]}"
                                    />
                                </div>
                            </div>
                        </div>
                        <div
                            class="col-6 col-md flex-grow-1"
                            attrs="{'invisible': [('odoo_newest', '=', False)]}"
                        >
                            <div class="mk_check_kpi border rounded p-3 h-100">
                                <div class="text-muted mb-1">Newest version</div>
                                <field name="odoo_newest"/>
                                <div class="small text-muted">
                                    Build
                                    <field name="odoo_image" class="mk_check_note"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <field name="is_latest" invisible="1"/>
                    <div
                        class="alert alert-secondary"
                        role="status"
                        attrs="{'invisible': [('is_latest', '=', True)]}"
                    >
                        This is an earlier check, and its counts are from that day. The
                        Overview shows what is open now.
                    </div>
                    <div
                        class="alert alert-success"
                        role="status"
                        attrs="{'invisible': ['|', ('is_latest', '=', False), ('open_finding_ids', '!=', [])]}"
                    >
                        Nothing needs your attention.
                    </div>
                    <field
                        name="open_finding_ids"
                        readonly="1"
                        attrs="{'invisible': [('open_finding_ids', '=', [])]}"
                    >
                        <tree create="false" delete="false" no_open="1">
                            <field name="res_id" invisible="1"/>
                            <field
                                name="severity"
                                widget="badge"
                                decoration-danger="severity == 'critical'"
                                decoration-warning="severity == 'high'"
                                decoration-info="severity == 'medium'"
                                decoration-muted="severity == 'low'"
                            />
                            <field name="name"/>
                            <field name="target"/>
                            <field name="detail"/>
                            <button
                                name="action_open_details"
                                type="object"
                                string="Details"
                                icon="fa-info-circle"
                            />
                            <button
                                name="action_open_accept"
                                type="object"
                                string="Accept"
                                icon="fa-check-square-o"
                            />
                            <button
                                name="action_open_record"
                                type="object"
                                string="Open Record"
                                icon="fa-external-link"
                                attrs="{'invisible': ['|', ('res_id', '=', False), ('res_id', '=', 0)]}"
                            />
                        </tree>
                        <kanban
                            create="false"
                            delete="false"
                            action="action_open_details"
                            type="object"
                        >
                                <field name="state"/>
                        <field name="res_id"/>
                        <templates>
                            <t t-name="kanban-box">
                                <div class="oe_kanban_global_click">
                                    <field
                                        name="severity"
                                        widget="badge"
                                        decoration-danger="severity == 'critical'"
                                        decoration-warning="severity == 'high'"
                                        decoration-info="severity == 'medium'"
                                        decoration-muted="severity == 'low'"
                                    />
                                    <div class="fw-bold mt-1">
                                        <field name="name"/>
                                    </div>
                                    <div t-if="record.target.raw_value">
                                        <field name="target"/>
                                    </div>
                                    <div t-if="record.detail.raw_value" class="text-muted">
                                        <field name="detail"/>
                                    </div>
                                    <div class="pt-2">
                                        <button
                                            t-if="record.state.raw_value == 'open'"
                                            name="action_open_accept"
                                            type="object"
                                            class="btn btn-secondary btn-sm me-1"
                                        >
                                            Accept
                                        </button>
                                        <button
                                            t-if="record.state.raw_value == 'accepted'"
                                            name="action_reopen"
                                            type="object"
                                            class="btn btn-secondary btn-sm me-1"
                                        >
                                            Reopen
                                        </button>
                                        <button
                                            t-if="record.res_id.raw_value"
                                            name="action_open_record"
                                            type="object"
                                            class="btn btn-secondary btn-sm"
                                        >
                                            Open Record
                                        </button>
                                    </div>
                                </div>
                            </t>
                        </templates>
                        </kanban>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_check_run" model="ir.actions.act_window">
        <field name="name">History</field>
        <field name="res_model">muk_check.run</field>
        <field name="view_mode">tree,graph,form</field>
    </record>

    <record id="action_check_overview" model="ir.actions.server">
        <field name="name">Overview</field>
        <field name="model_id" ref="model_muk_check_run"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_overview()</field>
    </record>

</odoo>
