<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_ir_module_module_update_search" model="ir.ui.view">
        <field name="name">ir.module.module.update.search</field>
        <field name="model">ir.module.module</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <search>
                <field name="shortdesc"/>
                <field name="name"/>
                <filter
                    name="attention"
                    string="Needs Attention"
                    domain="['|', '|', '|', ('store_status', '!=', False), ('upgrade_status', '!=', False), ('translation_status', '!=', False), ('disk_status', '!=', False)]"
                />
                <separator/>
                <filter
                    name="store_update"
                    string="Store Update"
                    domain="[('store_status', '!=', False)]"
                />
                <filter
                    name="upgrade_needed"
                    string="Upgrade Needed"
                    domain="[('upgrade_status', '!=', False)]"
                />
                <filter
                    name="translations_changed"
                    string="Translations Changed"
                    domain="[('translation_status', '!=', False)]"
                />
                <filter
                    name="missing"
                    string="Missing"
                    domain="[('disk_status', '!=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="view_ir_module_module_update_list" model="ir.ui.view">
        <field name="name">ir.module.module.update.list</field>
        <field name="model">ir.module.module</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <tree js_class="mk_check_list" create="false" delete="false">
                <header>
                    <button
                        name="action_check_updates"
                        type="object"
                        string="Check Now"
                        class="btn-primary mk_check_always"
                    />
                    <button
                        name="button_immediate_upgrade"
                        type="object"
                        string="Upgrade"
                        confirm="This also upgrades the installed apps that depend on this one, and interrupts every user while it runs. Continue?"
                    />
                </header>
                <field name="shortdesc"/>
                <field name="name" optional="hide"/>
                <field name="update_state" widget="html"/>
                <field name="store_status" invisible="1"/>
                <field name="upgrade_status" invisible="1"/>
                <field name="translation_status" invisible="1"/>
                <field name="disk_status" invisible="1"/>
                <field name="latest_version" string="In Database"/>
                <field
                    name="installed_version"
                    string="On Disk"
                    attrs="{'invisible': [('disk_status', '!=', False)]}"
                />
                <field name="store_version" decoration-warning="store_status"/>
                <button
                    name="action_open_store"
                    type="object"
                    icon="fa-external-link"
                    string="Open Store"
                    attrs="{'invisible': [('store_version', '=', False)]}"
                />
                <button
                    name="button_immediate_upgrade"
                    type="object"
                    icon="fa-arrow-circle-up"
                    string="Upgrade"
                    attrs="{'invisible': [('upgrade_status', '=', False)]}"
                    confirm="This also upgrades the installed apps that depend on this one, and interrupts every user while it runs. Continue?"
                />
                <button
                    name="action_dismiss_upgrade"
                    type="object"
                    icon="fa-bell-slash"
                    string="Dismiss"
                    attrs="{'invisible': [('upgrade_status', '=', False)]}"
                />
                <button
                    name="action_reload_translations"
                    type="object"
                    string="Load New Terms"
                    icon="fa-language"
                    attrs="{'invisible': [('translation_status', '=', False)]}"
                />
                <button
                    name="action_reload_translations"
                    type="object"
                    string="Overwrite Terms"
                    icon="fa-pencil"
                    attrs="{'invisible': [('translation_status', '=', False)]}"
                    confirm="This replaces translations customized in this database. Continue?"
                    context="{'overwrite': True}"
                />
            </tree>
        </field>
    </record>

    <record id="view_ir_module_module_form" model="ir.ui.view">
        <field name="name">ir.module.module.form</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.module_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group string="Store" attrs="{'invisible': [('store_version', '=', False)]}">
                    <group>
                        <field name="store_version"/>
                        <field name="store_checked_at"/>
                        <button
                            name="action_open_store"
                            type="object"
                            string="Open Store"
                            colspan="2"
                        />
                    </group>
                    <field name="store_changelog" colspan="2" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_update_check" model="ir.actions.act_window">
        <field name="name">Update Check</field>
        <field name="res_model">ir.module.module</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_ir_module_module_update_list"/>
        <field name="search_view_id" ref="view_ir_module_module_update_search"/>
        <field name="domain">[('state', '=', 'installed'), ('imported', '=', False), ('author', 'not ilike', 'Odoo S'), ('author', 'not ilike', 'Odoo PS'), '!', ('author', '=ilike', 'Odoo'), '!', ('author', '=ilike', 'Odoo, %')]</field>
        <field name="context">{'search_default_attention': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">All your apps are up to date</p>
            <p>Press Check Now to compare them with the store and the code on disk.</p>
        </field>
    </record>

</odoo>
