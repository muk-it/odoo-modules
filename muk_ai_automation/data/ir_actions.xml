<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="action_ai_automation_rules" model="ir.actions.act_window">
        <field name="name">Automation Rules</field>
        <field name="path">ai-automation-rules</field>
        <field name="res_model">base.automation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('action_server_ids.state', '=', 'ai_agent')]</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('base_automation.view_base_automation_kanban')}),
            ]"
        />
        <field name="context">{
            'search_default_filter_action_agent': 1,
            'form_view_ref': 'muk_ai_automation.view_ai_agent_automation_form',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI automation rules yet.
            </p>
            <p>
                Create a base automation rule whose server action is set to
                <em>Run AI Agent</em> to fire an AI agent from any record
                event.
            </p>
        </field>
    </record>

    <record id="action_ai_scheduled_actions" model="ir.actions.act_window">
        <field name="name">Scheduled Actions</field>
        <field name="path">ai-scheduled-actions</field>
        <field name="res_model">ir.cron</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('ir_actions_server_id.state', '=', 'ai_agent')]</field>
        <field name="context">{'active_test': False}</field>
        <field
            name="view_ids"
            eval="[
                (5, 0, 0),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_ai_agent_cron_kanban')}),
            ]"
        />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No AI scheduled actions yet.
            </p>
            <p>
                Attach a scheduled action to a server action with state
                <em>Run AI Agent</em> to fire an AI agent on a cron cadence.
            </p>
        </field>
    </record>

</odoo>
