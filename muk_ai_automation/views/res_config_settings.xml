<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai_automation</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="muk_ai.view_res_config_settings_form"/>
		<field name="arch" type="xml">
			<xpath expr="//setting[@id='muk_ai_addon_schedule']" position="before">
				<setting
					id="muk_ai_addon_automation"
					string="MuK AI Automation"
					help="Run AI agents as server actions and automation rule steps."
				>
					<field
						name="module_muk_ai_automation"
						widget="module_link"
					/>
					<div class="content-group" invisible="not module_muk_ai_automation" id="msg_module_muk_ai_automation">
						<div class="mt16">
							<a href="/odoo/action-muk_ai_automation.action_ai_automation_rules" class="link-primary text-decoration-none">
								<i class="fa fa-arrow-right me-1"/>Manage AI Automation Rules
							</a>
						</div>
					</div>
				</setting>
			</xpath>
		</field>
	</record>

</odoo>
