<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.muk_ai_automation</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="muk_ai.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='muk_ai_addon_schedule']" position="before">
                <setting
                    id="muk_ai_addon_automation"
                    string="Automation"
                    help="Run agents from server actions, automation rules and schedules."
                >
                    <field name="module_muk_ai_automation" widget="module_link"/>
                    <div
                        class="content-group"
                        invisible="not module_muk_ai_automation"
                        id="msg_module_muk_ai_automation"
                    >
                        <div class="mt16">
                            <button
                                name="%(muk_ai_automation.action_ai_agent_actions)d"
                                type="action"
                                string="Manage Agent Actions"
                                icon="oi-arrow-right"
                                class="btn-link"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
