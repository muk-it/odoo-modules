#: model:muk_ai.skill,description:muk_ai_chatter.skill_compose_summary
msgid "Retell the conversation as a message that reads on its own."
msgstr "Reprend la conversation sous forme d'un message qui se lit seul."

#. module: muk_ai_chatter
#. odoo-javascript
#: code:addons/muk_ai_chatter/static/src/composer/compose_panel/compose_panel.js:0
