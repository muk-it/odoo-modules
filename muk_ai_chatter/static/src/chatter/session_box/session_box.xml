<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="muk_ai_chatter.AISessionBox">
        <div t-if="props.open and state.total" class="mk_session_box">
            <div class="d-flex align-items-center">
                <hr class="flex-grow-1"/>
                <span class="p-3 fw-bold">AI Sessions</span>
                <hr class="flex-grow-1"/>
            </div>
            <div class="d-flex flex-column">
                <div
                    t-foreach="state.sessions"
                    t-as="session"
                    t-key="session.id"
                    class="mk_session_box_item d-flex align-items-center gap-2 px-2 py-1 cursor-pointer"
                    role="button"
                    tabindex="0"
                    t-att-title="tooltip(session)"
                    t-on-click="() => this.openSession(session)"
                    t-on-keydown="(ev) => this.onItemKeydown(ev, session)"
                >
                    <span
                        class="mk_session_box_state d-flex align-items-center flex-shrink-0"
                        t-att-class="stateClass(session)"
                    >
                        <span class="mk_session_box_dot"/>
                    </span>
                    <span class="mk_session_box_name text-truncate flex-grow-1" t-out="session.name"/>
                    <span
                        class="mk_session_box_date flex-shrink-0"
                        t-att-title="startedAt(session)"
                        t-out="relativeDate(session)"
                    />
                </div>
                <button
                    t-if="hasMore"
                    type="button"
                    class="mk_session_box_more btn btn-link btn-sm align-self-center"
                    t-on-click="() => this.openAll()"
                >
                    View all <t t-out="state.total"/> sessions
                </button>
            </div>
        </div>
    </t>
</templates>
