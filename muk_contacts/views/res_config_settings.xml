<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//block[@name='contacts_setting_container']/setting[1]"
                position="before"
            >
                <setting
                    id="contact_number_automation"
                    help="Activate to automatically generate contact numbers"
                >
                    <field
                        name="active_contact_number_automation"
                        string="Contact Number Automation"
                    />
                    <button
                        name="action_open_contact_number_sequence"
                        type="object"
                        string="Configure Sequence"
                        icon="east"
                        class="btn-link"
                    />
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
