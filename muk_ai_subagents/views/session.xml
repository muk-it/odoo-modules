<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_ai_session_search_inherit_subagents" model="ir.ui.view">
		<field name="name">muk_ai.session.search.inherit.subagents</field>
		<field name="model">muk_ai.session</field>
		<field name="inherit_id" ref="muk_ai.view_ai_session_search"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='user_id']" position="after">
				<field name="parent_session_id"/>
			</xpath>
			<xpath expr="//filter[@name='error']" position="after">
				<separator/>
				<filter
					name="subagents"
					string="Subagents"
					domain="[('parent_session_id', '!=', False)]"
				/>
				<filter
					name="delegating"
					string="With Subagents"
					domain="[('child_session_ids', '!=', False)]"
				/>
			</xpath>
			<xpath expr="//filter[@name='group_user']" position="after">
				<filter
					name="group_parent"
					string="Parent Session"
					context="{'group_by': 'parent_session_id'}"
				/>
				<filter
					name="group_stop_reason"
					string="Stop Reason"
					context="{'group_by': 'stop_reason'}"
				/>
			</xpath>
		</field>
	</record>

	<record id="view_ai_session_list_inherit_subagents" model="ir.ui.view">
		<field name="name">muk_ai.session.list.inherit.subagents</field>
		<field name="model">muk_ai.session</field>
		<field name="inherit_id" ref="muk_ai.view_ai_session_list"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='user_id']" position="after">
				<field name="parent_session_id" optional="hide"/>
				<field name="stop_reason" optional="hide"/>
			</xpath>
		</field>
	</record>

	<record id="view_ai_session_form_inherit_subagents" model="ir.ui.view">
		<field name="name">muk_ai.session.form.inherit.subagents</field>
		<field name="model">muk_ai.session</field>
		<field name="inherit_id" ref="muk_ai.view_ai_session_form"/>
		<field name="arch" type="xml">
			<xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
				<div class="oe_button_box" name="button_box">
					<button
						name="action_open_children"
						type="object"
						class="oe_stat_button"
						icon="fa-sitemap"
						invisible="not child_session_count"
					>
						<field name="child_session_count" widget="statinfo" string="Subagents"/>
					</button>
				</div>
			</xpath>
			<xpath expr="//notebook/page[@name='conversation']" position="before">
				<page
					string="Delegation"
					name="delegation"
					invisible="not parent_session_id and not child_session_count"
				>
					<group>
						<group string="Run">
							<field name="parent_session_id"/>
						</group>
						<group string="Outcome">
							<field name="stop_reason"/>
							<field name="heartbeat_at"/>
						</group>
					</group>
					<group string="Brief" invisible="not parent_session_id">
						<field
							name="delegation_brief"
							widget="json_code"
							nolabel="1"
							colspan="2"
						/>
					</group>
				</page>
			</xpath>
		</field>
	</record>

</odoo>
