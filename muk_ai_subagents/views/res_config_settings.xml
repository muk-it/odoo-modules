<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai_subagents</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="muk_ai.view_res_config_settings_form"/>
		<field name="arch" type="xml">
			<xpath expr="//block[@name='muk_ai_settings_limits']" position="after">
				<block title="Subagents" name="muk_ai_subagents_settings">
					<setting id="muk_ai_subagent_run_cost_limit">
						<label string="Run Cost Limit" for="ai_subagent_run_cost_limit"/>
						<div class="text-muted">
							Maximum spend of a chat and every subagent it delegates to, together. Set to 0 to disable.
						</div>
						<div class="content-group mt16">
							<div class="row">
								<div class="o_light_label">
									<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_subagent_run_cost_limit"/>
									<field name="ai_subagent_run_cost_limit" class="w-25 text-center" nolabel="1"/>
									<span class="col-auto ms-2">per Run</span>
								</div>
							</div>
						</div>
					</setting>
					<setting id="muk_ai_subagent_stall_timeout">
						<label string="Stalled Subagents" for="ai_subagent_stall_timeout"/>
						<div class="text-muted">
							A subagent that completes no round for this long is stopped and hands back what it found.
						</div>
						<div class="content-group mt16">
							<div class="row">
								<div class="o_light_label">
									<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Stop after" for="ai_subagent_stall_timeout"/>
									<field name="ai_subagent_stall_timeout" class="w-25 text-center" nolabel="1"/>
									<span class="col-auto ms-2">Seconds</span>
								</div>
							</div>
						</div>
					</setting>
				</block>
			</xpath>
		</field>
	</record>

</odoo>
