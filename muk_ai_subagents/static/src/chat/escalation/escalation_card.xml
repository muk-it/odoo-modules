<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai_subagents.SubagentEscalations">
        <t t-foreach="blocked" t-as="child" t-key="child.id">
            <t t-set="ask" t-value="askOf(child)"/>
            <div class="mk_turn mk_turn_assistant mk_subagent_escalation" t-att-class="colorClass(child)" t-att-data-child-id="child.id">
                <div class="mk_ask_card mk_subagent_ask d-flex">
                    <span class="mk_agent_bar"/>
                    <div class="mk_subagent_ask_body flex-grow-1">
                        <div class="mk_ask_head d-flex align-items-center">
                            <i class="fa me-2" t-att-class="ask.kind === 'approval' ? 'fa-shield' : 'fa-question-circle'"/>
                            <strong class="text-truncate" t-esc="title(child)"/>
                            <span class="ms-2 text-muted small text-truncate" t-if="child.agent_name" t-esc="child.agent_name"/>
                            <button
                                type="button"
                                class="btn btn-link btn-sm mk_subagent_ask_open ms-auto p-0"
                                t-att-title="openLabel(child)"
                                t-att-aria-label="openLabel(child)"
                                t-on-click="() => this.onOpen(child)"
                            >
                                <i class="fa fa-file-text-o"/>
                            </button>
                        </div>
                        <div class="mk_ask_body">
                            <p class="mb-2 small" t-if="ask.text" t-esc="ask.text"/>
                            <t t-if="ask.preview and ask.preview.kind">
                                <t t-call="muk_ai.AskPreview">
                                    <t t-set="preview" t-value="ask.preview"/>
                                </t>
                            </t>
                        </div>
                        <div class="mk_ask_resolved small text-muted" t-if="!canWrite">Waiting for the owner to answer.</div>
                        <t t-elif="ask.kind === 'approval'">
                            <div class="mk_ask_actions d-flex flex-wrap gap-2">
                                <button class="btn btn-sm btn-primary mk_subagent_approve" t-att-disabled="isBusy(child) ? 'disabled' : null" t-on-click="() => this.onApprove(child)">
                                    <i class="fa fa-check me-1"/>Approve
                                </button>
                                <button class="btn btn-sm btn-outline-primary mk_subagent_approve_session" t-att-disabled="isBusy(child) ? 'disabled' : null" title="Auto-approve matching calls for the rest of this agent's run" t-on-click="() => this.onApproveForSession(child)">
                                    <i class="fa fa-star me-1"/>Allow for session
                                </button>
                                <button class="btn btn-sm btn-outline-danger mk_subagent_reject" t-att-disabled="isBusy(child) ? 'disabled' : null" t-on-click="() => this.onReject(child)">
                                    <i class="fa fa-times me-1"/>Reject
                                </button>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="mk_ask_options d-flex flex-wrap gap-2" t-if="ask.options and ask.options.length">
                                <t t-foreach="ask.options" t-as="opt" t-key="opt_index">
                                    <button
                                        class="btn btn-sm btn-outline-primary mk_ask_option mk_subagent_option"
                                        t-att-disabled="isBusy(child) ? 'disabled' : null"
                                        t-on-click="() => this.onAnswer(child, opt)"
                                        t-esc="opt"
                                    />
                                </t>
                            </div>
                            <div class="mk_subagent_answer d-flex align-items-center gap-2 mt-2">
                                <input
                                    type="text"
                                    class="form-control form-control-sm mk_subagent_answer_input"
                                    placeholder="Type your answer…"
                                    t-att-value="this.answerDraft(child)"
                                    t-att-disabled="isBusy(child) ? 'disabled' : null"
                                    t-on-input="(ev) => this.onAnswerInput(child, ev)"
                                    t-on-keydown="(ev) => this.onAnswerKeydown(child, ev)"
                                />
                                <button
                                    type="button"
                                    class="btn btn-sm btn-primary mk_subagent_answer_send"
                                    t-att-disabled="isBusy(child) or !this.answerDraft(child).trim() ? 'disabled' : null"
                                    t-on-click="() => this.onAnswer(child, this.answerDraft(child))"
                                >
                                    <i class="fa fa-arrow-up"/>
                                </button>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </t>

</templates>
