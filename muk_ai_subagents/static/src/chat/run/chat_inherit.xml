<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai_subagents.ChatInherit" t-inherit="muk_ai.Chat" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='renderedTurns']" position="after">
            <SubagentEscalations session="session"/>
        </xpath>
        <xpath expr="//div[hasclass('mk_composer_wrap')]/ChatComposer" position="before">
            <SubagentRunStrip session="session"/>
        </xpath>
        <xpath expr="//div[hasclass('mk_composer_wrap')]/ChatComposer" position="attributes">
            <attribute name="canAttach">!session.state.subagentOpen and session.canAttach()</attribute>
        </xpath>
        <xpath expr="//div[hasclass('mk_messages_wrap')]" position="attributes">
            <attribute name="t-if">!session.state.subagentOpen</attribute>
        </xpath>
        <xpath expr="//div[hasclass('mk_messages_wrap')]" position="after">
            <SubagentChildView t-if="session.state.subagentOpen" session="session"/>
        </xpath>
    </t>

    <t t-name="muk_ai_subagents.ChatWindowInherit" t-inherit="muk_ai.ChatWindow" t-inherit-mode="extension">
        <xpath expr="//t[@t-foreach='renderedTurns']" position="after">
            <SubagentEscalations session="session"/>
        </xpath>
        <xpath expr="//div[hasclass('mk_window_body')]" position="attributes">
            <attribute name="t-if">!session.state.subagentOpen</attribute>
        </xpath>
        <xpath expr="//div[hasclass('mk_window_body')]" position="after">
            <SubagentChildView t-if="session.state.subagentOpen" session="session" compact="true"/>
        </xpath>
        <xpath expr="//div[hasclass('mk_window_composer')]/ChatComposer" position="before">
            <SubagentRunStrip session="session"/>
        </xpath>
        <xpath expr="//div[hasclass('mk_window_composer')]/ChatComposer" position="attributes">
            <attribute name="canAttach">!session.state.subagentOpen and session.canAttach()</attribute>
        </xpath>
    </t>

</templates>
