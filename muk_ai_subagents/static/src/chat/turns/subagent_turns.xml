<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai_subagents.SubagentSpawnTurn">
        <div class="mk_turn mk_turn_command mk_subagent_spawn" t-att-title="props.turn.at || ''">
            <button type="button" class="mk_note mk_subagent_spawn_line" t-on-click="() => this.onClick()">
                <span class="mk_subagent_spawn_dots d-inline-flex align-items-center">
                    <t t-foreach="props.turn.children" t-as="child" t-key="child.id">
                        <span class="mk_agent_dot" t-att-class="colorClass(child)" t-att-title="child.name"/>
                    </t>
                </span>
                <span class="mk_subagent_spawn_label" t-esc="label"/>
                <i class="fa fa-angle-right mk_subagent_spawn_go"/>
            </button>
        </div>
    </t>

    <t t-name="muk_ai_subagents.SubagentSteerTurn">
        <div class="mk_turn mk_turn_command mk_subagent_steer" t-att-class="colorClass">
            <span class="mk_note mk_subagent_steer_line">
                <span class="mk_agent_dot"/>
                <i class="fa fa-level-down"/>
                <span class="mk_subagent_steer_label" t-esc="label"/>
                <span class="mk_subagent_steer_text text-truncate" t-att-title="props.turn.text" t-esc="props.turn.text"/>
            </span>
        </div>
    </t>

    <t t-name="muk_ai_subagents.SubagentResultTurn">
        <div class="mk_turn mk_turn_assistant mk_subagent_result" t-att-class="colorClass + (isClean ? '' : ' mk_subagent_result_failed') + (state.expanded ? ' mk_subagent_result_open' : '')" t-att-title="props.turn.at || ''">
            <div class="mk_subagent_result_card d-flex">
                <span class="mk_agent_bar"/>
                <div class="mk_subagent_result_body flex-grow-1">
                    <button type="button" class="mk_subagent_result_head d-flex align-items-center" t-att-aria-expanded="state.expanded" t-on-click="() => this.toggle()">
                        <i class="fa fa-chevron-right mk_chevron"/>
                        <span class="mk_subagent_result_name text-truncate" t-esc="props.turn.name"/>
                        <span class="mk_subagent_result_agent text-truncate" t-if="props.turn.agentName" t-esc="props.turn.agentName"/>
                        <i class="fa fa-exclamation-triangle mk_subagent_result_flag" t-if="!isClean" t-att-title="warning"/>
                        <span class="mk_subagent_result_meta ms-auto">
                            <span class="mk_subagent_result_duration" t-if="duration" t-esc="duration"/>
                            <span class="mk_subagent_result_cost"><i class="fa fa-dollar me-1"/><t t-esc="cost"/></span>
                        </span>
                    </button>
                    <div class="mk_subagent_result_warning" t-if="!isClean" role="alert">
                        <i class="fa fa-exclamation-triangle me-1"/><t t-esc="warning"/>
                    </div>
                    <div class="mk_subagent_result_summary text-truncate" t-if="!state.expanded and summaryLine" t-esc="summaryLine"/>
                    <div class="mk_subagent_result_summary_full mk_markdown" t-if="state.expanded and props.turn.summary" t-out="summaryHtml"/>
                    <button type="button" class="mk_subagent_result_view" t-on-click="() => this.onOpen()">
                        Open conversation <i class="fa fa-angle-right"/>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
