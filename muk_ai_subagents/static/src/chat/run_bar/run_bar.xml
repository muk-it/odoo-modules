<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai_subagents.SubagentBar" owl="1">
        <div
            t-if="parent"
            class="mk_run_bar d-flex align-items-center gap-2"
            t-att-class="'mk_agent_' + parent.color"
        >
            <span class="mk_run_badge d-inline-flex flex-shrink-0 align-items-center justify-content-center rounded-circle fw-semibold" t-esc="parent.agent_name.charAt(0).toUpperCase()"/>
            <span class="d-flex flex-column flex-grow-1 min-w-0">
                <span class="text-truncate">
                    Subagent of
                    <button class="btn btn-link btn-sm mk_run_bar_parent p-0 align-baseline text-decoration-none" type="button" t-on-click="() => this.openParent()" t-esc="parent.parent_name"/>
                </span>
                <span t-if="steerHint" class="mk_run_bar_hint small text-muted text-truncate" t-esc="steerHint"/>
            </span>
        </div>
        <SubagentRunCard t-elif="docked" turn="docked" session="props.session" docked="true"/>
    </t>

    <t t-name="muk_ai_subagents.ChatInherit" t-inherit="muk_ai.Chat" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mk_composer_wrap')]/ChatComposer" position="before">
            <SubagentBar session="session"/>
        </xpath>
    </t>

    <t t-name="muk_ai_subagents.ChatWindowInherit" t-inherit="muk_ai.ChatWindow" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mk_window_composer')]/ChatComposer" position="before">
            <SubagentBar session="session"/>
        </xpath>
    </t>

</templates>
