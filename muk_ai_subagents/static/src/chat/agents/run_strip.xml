<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai_subagents.SubagentRunStrip">
        <div class="mk_run_strip" t-if="hasRun" t-att-class="expanded ? 'mk_run_strip_open' : ''">
            <span class="mk_run_strip_live visually-hidden" role="status" aria-atomic="true" t-esc="liveSummary"/>
            <div class="mk_run_strip_roster" t-if="expanded">
                <div class="mk_run_strip_list" role="list">
                    <t t-foreach="sections" t-as="section" t-key="section.key">
                        <div class="mk_agents_section" t-att-class="'mk_agents_section_' + section.key">
                            <div class="mk_agents_section_label" t-esc="section.label"/>
                            <t t-foreach="section.children" t-as="child" t-key="child.id">
                                <t t-call="muk_ai_subagents.AgentRow"/>
                            </t>
                        </div>
                    </t>
                    <t t-if="collapsed.length">
                        <div class="mk_agents_section mk_agents_section_collapsed">
                            <button
                                type="button"
                                class="mk_agents_done_toggle"
                                t-att-aria-expanded="state.doneExpanded"
                                t-on-click="() => this.toggleDone()"
                            >
                                <i class="fa" t-att-class="state.doneExpanded ? 'fa-caret-down' : 'fa-caret-right'"/>
                                <span t-esc="doneLabel"/>
                            </button>
                            <t t-if="state.doneExpanded">
                                <t t-foreach="collapsed" t-as="child" t-key="child.id">
                                    <t t-call="muk_ai_subagents.AgentRow"/>
                                </t>
                            </t>
                        </div>
                    </t>
                </div>
                <div class="mk_agents_footer d-flex align-items-center">
                    <span class="mk_agents_cost" t-att-class="{ mk_agents_cost_over: overBudget }" title="Total cost of the run against its limit">
                        <i class="fa fa-dollar"/>
                        <t t-esc="totalCost"/>
                        <t t-if="costLimit"> / <t t-esc="costLimit"/></t>
                    </span>
                    <button
                        type="button"
                        class="btn btn-sm btn-outline-danger mk_agents_stop_all ms-auto"
                        t-att-disabled="!anyActive or !canWrite ? 'disabled' : null"
                        t-on-click="() => this.onStopAll()"
                    >
                        <i class="fa fa-stop me-1"/>Stop all
                    </button>
                </div>
            </div>
            <button
                type="button"
                class="mk_run_strip_line d-flex align-items-center"
                t-att-class="summaryClass"
                t-att-aria-expanded="expanded"
                t-att-title="toggleLabel"
                t-on-click="() => this.toggle()"
            >
                <span class="mk_run_strip_dots d-inline-flex align-items-center">
                    <t t-foreach="dots" t-as="child" t-key="child.id">
                        <span class="mk_agent_dot" t-att-class="colorClass(child.color) + (isFinished(child) ? ' mk_agent_dot_done' : '')" t-att-title="child.name"/>
                    </t>
                    <span class="mk_run_strip_more" t-if="moreDots" t-esc="moreDots"/>
                </span>
                <span class="mk_run_strip_text text-truncate" t-esc="summary"/>
                <span class="mk_run_strip_cost ms-auto" t-if="costWorthShowing" t-att-class="{ mk_agents_cost_over: overBudget }">
                    <t t-esc="totalCost"/> / <t t-esc="costLimit"/>
                </span>
                <i class="fa mk_run_strip_caret" t-att-class="(expanded ? 'fa-angle-down' : 'fa-angle-up') + (costWorthShowing ? '' : ' ms-auto')"/>
            </button>
        </div>
    </t>

    <t t-name="muk_ai_subagents.AgentRow">
        <div class="mk_agent_row_wrap" role="listitem">
            <div
                class="mk_agent_row d-flex align-items-center"
                t-att-class="rowClass(child)"
                t-att-data-child-id="child.id"
                role="button"
                tabindex="0"
                t-att-aria-expanded="state.detailId === child.id"
                t-on-click="() => this.onRowClick(child)"
                t-on-keydown="(ev) => this.onRowKeydown(child, ev)"
            >
                <span class="mk_agent_bar"/>
                <span class="mk_agent_row_body d-flex flex-column">
                    <span class="mk_agent_row_head d-flex align-items-center">
                        <span class="mk_agent_row_name text-truncate" t-esc="child.name"/>
                        <i t-if="isBlocked(child)" class="fa fa-hand-paper-o mk_agent_row_flag" title="Needs you"/>
                        <i t-elif="isFailed(child)" class="fa fa-exclamation-triangle mk_agent_row_flag" t-att-title="child.stop_reason"/>
                        <i t-elif="isFinished(child)" class="fa fa-check mk_agent_row_flag"/>
                        <i t-elif="isStuck(child)" class="fa fa-repeat mk_agent_row_flag" title="Repeating itself"/>
                        <i t-else="" class="fa fa-circle-o-notch fa-spin mk_agent_row_flag"/>
                        <span class="mk_agent_row_elapsed ms-auto" t-esc="elapsed(child)"/>
                    </span>
                    <span class="mk_agent_row_activity text-truncate" t-att-title="activity(child)" t-esc="activity(child)"/>
                </span>
            </div>
            <div class="mk_agent_detail" t-if="state.detailId === child.id">
                <div class="mk_agent_detail_stuck" t-if="isStuck(child)" role="alert">
                    <i class="fa fa-repeat me-1"/>This subagent keeps making the same call. It will be stopped if it does not move on.
                </div>
                <div class="mk_agent_detail_loading text-muted" t-if="state.peekLoading">
                    <i class="fa fa-spinner fa-spin me-1"/>Loading…
                </div>
                <div class="mk_agent_detail_calls" t-if="recentCalls.length">
                    <div class="mk_agent_detail_label">Recent calls</div>
                    <t t-foreach="recentCalls" t-as="call" t-key="call_index">
                        <div class="mk_agent_detail_call text-truncate" t-att-title="call.arguments">
                            <i class="fa fa-wrench me-1"/><t t-esc="call.name"/>
                        </div>
                    </t>
                </div>
                <div class="mk_agent_detail_actions d-flex align-items-center">
                    <button type="button" class="btn btn-sm btn-primary mk_agent_detail_open" t-on-click.stop="() => this.onOpen(child)">
                        <i class="fa fa-arrow-right me-1"/>Open conversation
                    </button>
                    <span class="mk_agent_detail_cost ms-auto"><i class="fa fa-dollar me-1"/><t t-esc="detailCost"/></span>
                    <button
                        type="button"
                        class="btn btn-sm btn-outline-danger ms-2 mk_agent_detail_stop"
                        t-if="canStop(child)"
                        t-on-click.stop="() => this.onStop(child)"
                    >
                        <i class="fa fa-stop me-1"/>Stop
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
