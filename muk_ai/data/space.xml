<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="1">

	<record id="space_waiting" model="muk_ai.space">
		<field name="name">Waiting for You</field>
		<field name="sequence">2</field>
		<field name="icon">back_hand</field>
		<field name="user_id" eval="False"/>
		<field name="domain">[('user_id', '=', uid), ('awaiting_user', '=', True)]</field>
		<field name="pinned" eval="True"/>
	</record>

	<record id="space_shared" model="muk_ai.space">
		<field name="name">Shared with Me</field>
		<field name="sequence">4</field>
		<field name="icon">share</field>
		<field name="user_id" eval="False"/>
		<field name="domain">[('share_user_ids', 'in', uid)]</field>
		<field name="pinned" eval="True"/>
	</record>

</odoo>
