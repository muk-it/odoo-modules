<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.Systray">
        <Dropdown position="'bottom-end'" menuClass="'mk_systray_menu'">
            <button class="mk_ai_systray_btn btn btn-link" title="MuK AI" t-ref="systrayBtn">
                <span class="mk_systray_icon_wrap">
                    <span class="mk_icon_ai mk_systray_icon"/>
                    <span t-if="hasRunning" class="mk_systray_badge">
                        <span class="mk_systray_dot mk_state_running" />
                    </span>
                </span>
                <span t-if="badge.count" class="mk_systray_count badge rounded-pill" t-esc="badgeLabel" />
            </button>
            <t t-set-slot="content">
                <div class="mk_systray_header">
                    <div class="fw-semibold d-flex align-items-center gap-2">
                        <span class="mk_icon_ai mk_systray_icon_sm"/>
                        <span>MuK AI</span>
                    </div>
                    <small t-if="hasRunning" class="text-muted">
                        <t t-esc="runningCount" />
                        <t t-if="runningCount === 1"> running</t>
                        <t t-else=""> running</t>
                    </small>
                </div>
                <DropdownItem class="'mk_systray_item mk_systray_action'" onSelected="() => this.onNewChat()">
                    <i class="fa fa-plus text-primary me-2" />
                    <span>New Chat</span>
                    <kbd class="mk_systray_hotkey ms-auto" t-esc="newChatHotkeyLabel" />
                </DropdownItem>
                <DropdownItem class="'mk_systray_item mk_systray_action'" onSelected="() => this.onOpenFullChat()">
                    <i class="fa fa-expand text-primary me-2" />
                    <span>Open Full Chat</span>
                    <kbd class="mk_systray_hotkey ms-auto" t-esc="fullChatHotkeyLabel" />
                </DropdownItem>
                <div class="mk_systray_divider" t-if="state.sessions.length" />
                <div class="mk_systray_group_label" t-if="state.sessions.length">Recent sessions</div>
                <t t-foreach="state.sessions" t-as="s" t-key="s.id">
                    <DropdownItem class="badge.isUnread(s.id) ? 'mk_systray_item mk_systray_item_unread' : 'mk_systray_item'" onSelected="() => this.onOpenSession(s)">
                        <span class="mk_systray_dot_wrap">
                            <span class="mk_systray_dot" t-att-class="statusDotClass(s.state)" />
                        </span>
                        <span class="mk_systray_name text-truncate" t-esc="s.name" />
                    </DropdownItem>
                </t>
                <div class="mk_systray_empty text-muted small px-3 py-2" t-if="state.loaded and !state.sessions.length">
                    No chats yet.
                </div>
            </t>
        </Dropdown>
    </t>

</templates>
