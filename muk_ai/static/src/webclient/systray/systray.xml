<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.Systray">
        <Dropdown position="'bottom-end'" menuClass="'mk_systray_menu'" state="this.menu">
            <button
                class="mk_systray_btn btn btn-link d-inline-flex align-items-center justify-content-center position-relative h-100 lh-1"
                t-att-title="this.chat.needs.rows.length ? `MuK AI - ${this.chat.needsTitle}` : 'MuK AI'"
                t-ref="this.button"
            >
                <span class="mk_systray_icon_wrap position-relative d-inline-flex" t-att-class="{ mk_systray_running: this.running }">
                    <span class="mk_icon_ai align-top"/>
                    <span t-if="this.chat.needs.rows.length" class="mk_systray_needs rounded-circle position-absolute pe-none"/>
                </span>
                <span
                    t-if="this.chat.badge.count"
                    class="o_badge badge rounded-pill"
                    t-out="this.chat.badge.count &gt; 99 ? '99+' : this.chat.badge.count"
                />
            </button>
            <t t-set-slot="content">
                <div class="mk_systray_top d-flex align-items-center gap-2 border-bottom">
                    <button class="btn btn-primary btn-sm flex-grow-1" t-att-title="this.hotkey" t-on-click="() => this.newChat()">
                        <i class="oi me-1" data-icon="add"/>New Chat
                    </button>
                    <button class="btn btn-light btn-sm" title="Open Full Chat" t-on-click="() => this.openFullChat()">
                        <i class="oi" data-icon="fullscreen"/>
                    </button>
                </div>
                <div t-if="this.state.record or this.state.actions.length" class="mk_systray_context border-bottom">
                    <DropdownItem t-if="this.state.record" class="'mk_systray_ask d-flex align-items-center gap-2 fw-semibold'" onSelected="() => this.newChat()">
                        <i class="oi text-primary" data-icon="chat"/>
                        <span class="flex-grow-1 text-truncate" t-out="this.recordTitle"/>
                        <i class="oi text-muted" data-icon="chevron_right"/>
                    </DropdownItem>
                    <div t-if="this.state.actions.length" class="d-flex align-items-start gap-1">
                        <div class="mk_systray_chips d-flex flex-wrap flex-grow-1 gap-1 overflow-hidden">
                            <DropdownItem
                                t-foreach="this.state.actions"
                                t-as="action"
                                t-key="action_index"
                                class="'mk_systray_chip btn btn-sm rounded-pill text-nowrap'"
                                attrs="{ title: action.preview or action.label }"
                                onSelected="() => this.start(action)"
                            >
                                <t t-out="action.label"/>
                            </DropdownItem>
                        </div>
                        <DropdownItem class="'mk_systray_chip btn btn-sm rounded-pill'" onSelected="() => this.more()">
                            <i class="oi" data-icon="more_horiz" title="All actions"/>
                        </DropdownItem>
                    </div>
                </div>
                <t t-if="this.chat.needs.rows.length">
                    <div class="mk_systray_heading d-flex align-items-center text-muted fw-semibold text-uppercase">
                        <span class="flex-grow-1">Needs you</span>
                        <span
                            class="mk_systray_needs_count badge rounded-pill text-bg-warning"
                            t-att-title="this.chat.needsTitle"
                            t-out="this.chat.needs.rows.length"
                        />
                    </div>
                    <div
                        t-foreach="this.chat.needs.rows"
                        t-as="need"
                        t-key="need.key"
                        class="mk_systray_need position-relative"
                        t-att-class="{ mk_systray_need_busy: this.chat.needs.busy[need.key], mk_systray_need_decide: need.approve }"
                    >
                        <DropdownItem class="'mk_systray_row'" onSelected="() => this.chat.openNeed(need)">
                            <span class="mk_systray_avatar position-relative flex-shrink-0">
                                <img t-if="need.agent_id" class="rounded-circle" t-att-src="this.agentImage(need.agent_id)" alt=""/>
                                <i t-else="" class="oi rounded-circle" t-att-data-icon="need.icon or 'back_hand'"/>
                                <span class="mk_systray_ring mk_state_waiting rounded-circle position-absolute"/>
                            </span>
                            <span class="d-flex flex-column flex-grow-1 min-w-0">
                                <span class="d-flex gap-2 align-items-baseline">
                                    <span class="mk_systray_name flex-grow-1 text-truncate" t-out="need.label"/>
                                </span>
                                <small class="text-muted text-truncate">
                                    <span t-if="need.session_id" class="mk_systray_tag me-1">
                                        <t t-if="need.icon === 'back_hand'">Approval</t>
                                        <t t-else="">Question</t>
                                    </span>
                                    <t t-if="need.changes?.length">
                                        <t t-foreach="need.changes" t-as="change" t-key="change_index">
                                            <t t-if="!change_first"> · </t>
                                            <t t-out="change.label"/> <t t-if="change.from"><t t-out="change.from"/> <i class="oi mk_systray_arrow" data-icon="arrow_right_alt"/> </t><t t-out="change.to"/>
                                        </t>
                                    </t>
                                    <t t-else="" t-out="need.sublabel"/>
                                </small>
                            </span>
                        </DropdownItem>
                        <div class="mk_systray_decide d-flex align-items-center gap-1 position-absolute top-50" t-att-class="{ 'pe-none': !need.approve }">
                            <t t-if="need.approve">
                                <button class="btn btn-sm btn-primary" title="Approve" t-on-click="() => this.chat.decideNeed(need, 'approve')">
                                    <i class="oi" data-icon="check"/>
                                </button>
                                <button class="btn btn-sm btn-light text-danger" title="Reject" t-on-click="() => this.chat.decideNeed(need, 'reject')">
                                    <i class="oi" data-icon="close"/>
                                </button>
                            </t>
                            <i t-else="" class="oi text-muted" data-icon="chevron_right"/>
                        </div>
                    </div>
                </t>
                <t t-if="this.recent.length">
                    <div class="mk_systray_heading d-flex align-items-center text-muted fw-semibold text-uppercase">
                        <span class="flex-grow-1">Chats</span>
                        <button
                            t-if="this.chat.badge.unreadIds.length"
                            class="btn btn-link btn-sm p-0 text-none fw-medium"
                            t-on-click="() => this.markAllRead()"
                        >Mark all as read</button>
                    </div>
                    <div class="mk_systray_chats">
                        <DropdownItem
                            t-foreach="this.recent"
                            t-as="row"
                            t-key="row.id"
                            class="{ mk_systray_row: true, mk_systray_unread: this.chat.badge.unreadIds.includes(row.id) }"
                            onSelected="() => this.chat.openWindow(row.id)"
                        >
                            <span class="mk_systray_avatar position-relative flex-shrink-0">
                                <img class="rounded-circle" t-att-src="this.agentImage(row.agent_id[0])" alt=""/>
                                <span
                                    t-if="['running', 'waiting', 'error'].includes(row.state)"
                                    class="mk_systray_ring rounded-circle position-absolute"
                                    t-att-class="this.statusInfo(row.state).cls"
                                />
                            </span>
                            <span class="d-flex flex-column flex-grow-1 min-w-0">
                                <span class="d-flex gap-2 align-items-baseline">
                                    <span class="mk_systray_name flex-grow-1 text-truncate" t-out="row.name"/>
                                    <small class="text-muted text-nowrap" t-out="row.state === 'running' ? '' : this.formatShortTimestamp(row.write_date)"/>
                                </span>
                                <small class="mk_systray_preview text-muted text-truncate">
                                    <span t-if="row.state === 'error'" class="mk_systray_tag mk_systray_tag_error me-1">Error</span>
                                    <t t-out="this.preview(row)"/>
                                </small>
                            </span>
                            <span t-if="this.chat.badge.unreadIds.includes(row.id)" class="mk_systray_unread_dot rounded-circle flex-shrink-0"/>
                        </DropdownItem>
                    </div>
                </t>
                <div t-elif="this.state.loaded and !this.rows.length" class="text-muted small px-3 py-2">No chats yet.</div>
                <div class="mk_systray_foot d-flex align-items-center justify-content-between border-top">
                    <button class="btn btn-link btn-sm p-0" t-on-click="() => this.openFullChat()">Open all chats</button>
                    <small class="text-muted" t-out="this.hotkey"/>
                </div>
            </t>
        </Dropdown>
    </t>

</templates>
