<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="muk_ai.ShareDialog" owl="1">
        <Dialog size="'md'" title="title">
            <div class="mk_share_dialog" t-if="state.fieldInfo">
                <label class="mk_share_label">Who may read it</label>
                <div class="mk_share_field">
                    <Record
                        resModel="'muk_ai.session'"
                        resId="props.sessionId"
                        fields="fields"
                        activeFields="activeFields"
                        mode="'edit'"
                        t-slot-scope="data"
                    >
                        <t t-esc="capture(data.record)"/>
                        <Field
                            name="'share_user_ids'"
                            record="data.record"
                            fieldInfo="state.fieldInfo"
                        />
                    </Record>
                </div>
                <div class="mk_share_note">
                    <i class="fa fa-eye me-1"/>
                    They see the whole transcript, including what the tools returned.
                    They cannot reply, rename or re-share it.
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="save">Save</button>
                <button class="btn btn-secondary" t-on-click="() => props.close()">
                    Close
                </button>
            </t>
        </Dialog>
    </t>

</templates>
