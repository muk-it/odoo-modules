<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.SpaceDialog">
        <Dialog size="'sm'" title="props.title">
            <div class="mk_space_dialog">
                <div class="mb-3">
                    <label class="form-label small text-muted">Name</label>
                    <input
                        type="text"
                        class="form-control"
                        t-ref="input"
                        t-att-value="state.name"
                        placeholder="Space name"
                        t-on-input="(ev) => this.onInput(ev)"
                        t-on-keydown="(ev) => this.onKeydown(ev)"
                    />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Icon</label>
                    <SelectMenu
                        choices="icons"
                        value="state.icon"
                        required="true"
                        searchPlaceholder="searchPlaceholder"
                        onSelect.bind="onIconSelect"
                        class="'mk_icon_selector_boxed'"
                        menuClass="'mk_icon_selector_menu'"
                    >
                        <span class="mk_icon_selector_value">
                            <i class="fa fa-fw" t-att-class="state.icon"/>
                            <span class="ms-2 text-truncate" t-esc="iconLabel"/>
                        </span>
                        <t t-set-slot="choice" t-slot-scope="scope">
                            <i class="fa fa-fw" t-att-class="scope.data.value" t-att-title="scope.data.label"/>
                        </t>
                    </SelectMenu>
                </div>
                <div>
                    <label class="form-label small text-muted">Default agent</label>
                    <select class="form-select" t-on-change="(ev) => this.onAgentChange(ev)">
                        <option value="">No default agent</option>
                        <t t-foreach="props.agents" t-as="agent" t-key="agent.id">
                            <option
                                t-att-value="agent.id"
                                t-att-selected="state.agentId === agent.id"
                                t-esc="agent.name"
                            />
                        </t>
                    </select>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="!canConfirm" t-on-click="() => this.confirm()">
                    Save
                </button>
                <button class="btn btn-secondary" t-on-click="() => this.cancel()">
                    Cancel
                </button>
            </t>
        </Dialog>
    </t>

</templates>
