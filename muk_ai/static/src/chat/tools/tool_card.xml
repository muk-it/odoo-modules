<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.ToolCard">
        <div class="mk_tool"
             t-att-class="(props.streaming ? 'mk_tool_streaming ' : '') + 'mk_tool_' + kind"
             t-att-data-expanded="props.expanded ? 1 : 0">
            <button type="button" class="mk_tool_head" t-on-click="() => this.onHeadClick()">
                <t t-if="props.streaming">
                    <span class="mk_tool_icon d-inline-flex align-items-center justify-content-center">
                        <i class="fa fa-circle-o-notch fa-spin" />
                    </span>
                </t>
                <t t-else="">
                    <i class="fa fa-chevron-right mk_chevron" />
                    <span class="mk_tool_icon d-inline-flex align-items-center justify-content-center">
                        <i class="fa mk_tool_glyph" t-att-class="props.block.icon or 'fa-wrench'" />
                    </span>
                </t>
                <span class="mk_tool_name" t-esc="props.block.label or props.block.name" />
                <span t-if="props.block.band"
                      class="mk_tool_band small ms-2"
                      t-att-class="resultHasError ? 'text-danger' : ''"
                      t-att-title="props.block.band"
                      t-esc="props.block.band" />
                <span t-else="" class="mk_tool_preview" t-esc="summary" />
                <span class="mk_tool_status" t-if="props.streaming">running…</span>
            </button>
            <t t-if="props.expanded and !props.streaming">
                <div class="mk_tool_body">
                    <div class="mk_tool_section" t-if="props.block.arguments">
                        <div class="mk_tool_section_label mb-1">Arguments</div>
                        <pre class="language-json"><code class="language-json" t-out="renderedArgs"/></pre>
                    </div>
                    <div class="mk_tool_section" t-if="props.block.result">
                        <div class="mk_tool_section_label mb-1">Result</div>
                        <pre t-att-class="'language-' + resultLang"><code t-att-class="'language-' + resultLang" t-out="renderedResult"/></pre>
                    </div>
                    <div class="mk_tool_section text-muted small" t-if="!props.block.result">
                        <i class="fa fa-spinner fa-spin me-1" />Running…
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
