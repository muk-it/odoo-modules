<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="muk_ai.ToolCard">
        <div class="mk_tool" t-att-class="props.streaming ? 'mk_tool_streaming' : ''" t-att-data-expanded="props.expanded ? 1 : 0">
            <button class="mk_tool_head" t-on-click="() => this.onHeadClick()">
                <t t-if="props.streaming">
                    <span class="mk_tool_icon d-inline-flex align-items-center justify-content-center">
                        <i class="fa fa-circle-o-notch fa-spin" />
                    </span>
                </t>
                <t t-else="">
                    <i class="fa fa-chevron-right mk_chevron" />
                    <span class="mk_tool_icon d-inline-flex align-items-center justify-content-center">
                        <i class="fa fa-wrench" />
                    </span>
                </t>
                <span class="mk_tool_name" t-esc="props.block.name" />
                <span class="mk_tool_preview" t-esc="summary" />
                <span class="mk_tool_status" t-if="props.streaming">running…</span>
            </button>
            <t t-if="props.expanded and !props.streaming">
                <div class="mk_tool_body">
                    <div class="mk_tool_section" t-if="props.block.arguments">
                        <div class="mk_tool_section_label mb-1">Arguments</div>
                        <pre class="language-json"><code class="language-json" t-esc="formatArgs(props.block.arguments)" /></pre>
                    </div>
                    <div class="mk_tool_section" t-if="props.block.result">
                        <div class="mk_tool_section_label mb-1">Result</div>
                        <pre class="language-json"><code class="language-json" t-esc="formatResult(props.block.result)" /></pre>
                    </div>
                    <div class="mk_tool_section text-muted small" t-if="!props.block.result">
                        <i class="fa fa-spinner fa-spin me-1" />Running…
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
