<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.ChatComposer">
        <div class="mk_composer_host position-relative">
        <div class="mk_composer_readonly" t-if="props.readonly">
            <i class="fa fa-eye"/>
            <span t-esc="readonlyNotice"/>
        </div>
        <t t-else="">
        <div class="mk_slash_popover" t-if="showSlashMenu">
            <t t-if="isAgentMode">
                <t t-foreach="agentMatches" t-as="agent" t-key="agent.id">
                    <button
                        type="button"
                        class="mk_slash_item"
                        t-att-class="{ active: agent_index === localState.slashActive }"
                        t-on-click="() => this.pickAgent(agent_index)"
                        t-on-mouseenter="() => this.hoverSlashCommand(agent_index)"
                    >
                        <span class="mk_slash_name" t-esc="agent.name"/>
                        <span class="mk_slash_hint" t-if="agent.id === props.activeAgentId">active</span>
                        <span class="mk_slash_hint" t-elif="agent.description" t-esc="agent.description"/>
                    </button>
                </t>
            </t>
            <t t-else="">
                <t t-foreach="slashCommands" t-as="cmd" t-key="cmd.name">
                    <button
                        type="button"
                        class="mk_slash_item"
                        t-att-class="{ active: cmd_index === localState.slashActive }"
                        t-on-click="() => this.pickSlashCommand(cmd_index)"
                        t-on-mouseenter="() => this.hoverSlashCommand(cmd_index)"
                    >
                        <code class="mk_slash_name" t-esc="cmd.name"/>
                        <span class="mk_slash_hint" t-esc="cmd.hint"/>
                    </button>
                </t>
            </t>
        </div>
        <div class="mk_composer d-flex flex-column gap-2">
            <div class="mk_attachments d-flex flex-wrap gap-2" t-if="props.attachments.length">
                <t t-foreach="props.attachments" t-as="attachment" t-key="attachment.id">
                    <AttachmentCard
                        attachment="attachment"
                        removable="true"
                        compact="true"
                        onOpen.bind="onOpenAttachment"
                        onRemove.bind="onRemoveAttachment"
                    />
                </t>
            </div>
            <div class="mk_composer_layout d-flex flex-column gap-2">
                <textarea
                    class="form-control border-0 shadow-none"
                    rows="1"
                    t-ref="input"
                    t-on-input="(ev) => this.onInputChange(ev)"
                    t-on-keydown="(ev) => this.onKeydown(ev)"
                    t-on-paste="(ev) => this.onPaste(ev)"
                    t-att-placeholder="props.placeholder"
                />
                <div class="mk_composer_row d-flex align-items-center gap-2">
                    <div class="mk_composer_left d-flex align-items-center gap-2">
                        <label
                            class="btn mk_attach rounded-circle mb-0"
                            t-att-class="{ 'mk_attach_disabled': !props.canAttach }"
                            t-att-for="fileInputId"
                            t-on-click="(ev) => this.onLabelClick(ev)"
                            title="Attach file"
                        >
                            <i class="fa fa-paperclip"/>
                        </label>
                        <input
                            type="file"
                            class="mk_file_input"
                            t-ref="fileInput"
                            t-att-id="fileInputId"
                            multiple="multiple"
                            t-att-accept="accept"
                            t-att-disabled="!props.canAttach ? 'disabled' : null"
                            t-on-change="(ev) => this.onFileInputChange(ev)"
                        />
                    </div>
                    <div class="mk_composer_right d-flex align-items-center gap-2">
                        <button
                            class="btn mk_send rounded-circle"
                            t-att-class="(props.canSend and props.isQueueing) ? 'mk_queue' : (props.canStop and !props.canSend) ? 'mk_stop' : ''"
                            t-on-click="() => this.onSendOrStop()"
                            t-att-disabled="(!props.canStop and !props.canSend) ? 'disabled' : null"
                            t-att-title="(props.canSend and props.isQueueing) ? 'Queue (sends after current turn)' : (props.canStop and !props.canSend) ? 'Stop' : 'Send'"
                        >
                            <i class="fa" t-att-class="(props.canSend and props.isQueueing) ? 'fa-clock-o' : (props.canStop and !props.canSend) ? 'fa-stop' : 'fa-arrow-up'"/>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div
            class="mk_composer_meta d-flex align-items-center gap-2 mt-1 ps-1"
            t-if="props.showHint or props.approvalPill or props.effortPill or props.extraPills.length"
        >
            <div class="mk_composer_hint" t-if="props.showHint">
                <span><kbd>Enter</kbd> to send</span>
                <span><kbd>Shift</kbd>+<kbd>Enter</kbd> for newline</span>
            </div>
            <div class="mk_composer_meta_actions ms-auto d-flex align-items-center gap-2">
                <t t-call="muk_ai.SessionPills">
                    <t t-set="approval" t-value="props.approvalPill"/>
                    <t t-set="effort" t-value="props.effortPill"/>
                    <t t-set="extra" t-value="props.extraPills"/>
                </t>
            </div>
        </div>
        </t>
        </div>
    </t>

    <t t-name="muk_ai.SessionPills">
        <Dropdown t-if="approval" menuClass="'mk_pill_menu'">
            <button
                type="button"
                class="btn btn-sm mk_approval_pill rounded-pill border-0 d-inline-flex align-items-center gap-1"
                t-att-class="approval.className"
                t-att-title="approval.tooltip"
            >
                <i class="fa" t-att-class="approval.icon"/>
                <span class="mk_pill_label" t-esc="approval.label"/>
                <i class="fa fa-angle-down mk_pill_caret"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="approval.options" t-as="opt" t-key="opt.mode">
                    <DropdownItem
                        class="'mk_pill_option'"
                        onSelected="() => this.onSetApproval(opt.mode)"
                    >
                        <t t-call="muk_ai.ComposerPillOption">
                            <t t-set="option" t-value="opt"/>
                        </t>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
        <t t-foreach="extra or []" t-as="entry" t-key="entry.key">
            <Dropdown menuClass="'mk_pill_menu'">
                <button
                    type="button"
                    class="btn btn-sm mk_session_pill rounded-pill border-0 d-inline-flex align-items-center gap-1"
                    t-att-class="entry.pill.className"
                    t-att-title="entry.pill.tooltip"
                >
                    <i class="fa" t-att-class="entry.pill.icon"/>
                    <span class="mk_pill_label" t-esc="entry.pill.label"/>
                    <i class="fa fa-angle-down mk_pill_caret"/>
                </button>
                <t t-set-slot="content">
                    <t t-foreach="entry.pill.options" t-as="opt" t-key="opt.value">
                        <DropdownItem
                            class="'mk_pill_option'"
                            onSelected="() => this.onSelectPill(entry.key, opt.value)"
                        >
                            <t t-call="muk_ai.ComposerPillOption">
                                <t t-set="option" t-value="opt"/>
                            </t>
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>
        </t>
        <Dropdown t-if="effort" menuClass="'mk_pill_menu'">
            <button
                type="button"
                class="btn btn-sm mk_session_pill rounded-pill border-0 d-inline-flex align-items-center gap-1"
                t-att-class="effort.className"
                t-att-title="effort.tooltip"
            >
                <i class="fa fa-tachometer"/>
                <span class="mk_pill_label" t-esc="effort.label"/>
                <i class="fa fa-angle-down mk_pill_caret"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="effort.options" t-as="opt" t-key="opt_index">
                    <DropdownItem
                        class="'mk_pill_option'"
                        onSelected="() => this.onSetEffort(opt.tier)"
                    >
                        <t t-call="muk_ai.ComposerPillOption">
                            <t t-set="option" t-value="opt"/>
                        </t>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

    <t t-name="muk_ai.ComposerPillOption">
        <span class="mk_pill_option_body d-flex align-items-start gap-2">
            <i class="fa fa-check mk_pill_check" t-att-class="{ invisible: !option.active }"/>
            <span>
                <span class="mk_pill_option_label d-block" t-esc="option.label"/>
                <span class="mk_pill_option_hint d-block" t-if="option.hint" t-esc="option.hint"/>
            </span>
        </span>
    </t>

</templates>
