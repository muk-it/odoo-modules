<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.Chat">
        <t t-set="session" t-value="this.session()"/>
        <div class="mk_chat d-flex flex-column h-100 position-relative overflow-hidden">
            <div class="mk_main_header d-flex flex-shrink-0 align-items-center gap-2 bg-100">
                <button
                    class="btn btn-link btn-sm mk_header_btn mk_sidebar_toggle d-inline-flex align-items-center justify-content-center p-0 border-0 rounded-3"
                    title="Toggle sidebar"
                    t-on-click="() => this.state.sidebarHidden = !this.state.sidebarHidden"
                >
                    <i class="oi" t-att-data-icon="this.state.sidebarHidden ? 'left_panel_open' : 'left_panel_close'"/>
                </button>
                <SessionStatus t-if="session" session="session"/>
                <span class="mk_main_title text-truncate fw-medium min-w-0">
                    <t t-if="session?.data.name" t-out="session.data.name"/>
                    <t t-else="">MuK AI Chat</t>
                </span>
                <t t-if="session">
                    <Dropdown disabled="session.readonly or !this.chat.agents().length">
                        <button
                            class="btn btn-sm mk_agent_pill rounded-pill d-inline-flex align-items-center gap-1 text-body fw-medium lh-sm"
                            t-att-title="this.agentTitle"
                        >
                            <i class="oi" data-icon="account_circle"/>
                            <span class="text-truncate">
                                <t t-if="session.agentName" t-out="session.agentName"/>
                                <t t-else="">No agent</t>
                            </span>
                            <i t-if="!session.readonly" class="oi" data-icon="arrow_drop_down"/>
                        </button>
                        <t t-set-slot="content">
                            <DropdownItem
                                t-foreach="this.chat.agents()"
                                t-as="agent"
                                t-key="agent.id"
                                class="{ active: session.data.agent_id?.[0] === agent.id }"
                                onSelected="() => session.setAgent(agent.id)"
                            >
                                <div class="fw-semibold" t-out="agent.name"/>
                                <small t-if="agent.description" class="text-muted" t-out="agent.description"/>
                            </DropdownItem>
                            <DropdownItem class="{ active: !session.data.agent_id }" onSelected="() => session.setAgent(null)">
                                <span class="text-muted fst-italic">No agent (defaults)</span>
                            </DropdownItem>
                        </t>
                    </Dropdown>
                    <i t-if="session.state.loading" class="oi oi-spin text-muted" data-icon="progress_activity" title="Loading session"/>
                    <div class="mk_header_tools d-flex align-items-center gap-1 ms-auto">
                        <ContextChip t-if="!this.ui.isSmall()" session="session"/>
                        <button
                            class="btn btn-link btn-sm mk_header_btn d-inline-flex align-items-center justify-content-center p-0 border-0 rounded-3"
                            t-att-class="{ active: this.state.searchOpen }"
                            title="Search this chat"
                            t-on-click="() => this.state.searchOpen = !this.state.searchOpen"
                        >
                            <i class="oi" data-icon="search"/>
                        </button>
                        <button
                            class="btn btn-link btn-sm mk_header_btn d-inline-flex align-items-center justify-content-center p-0 border-0 rounded-3"
                            t-att-class="{ active: !this.state.artifactsHidden }"
                            title="Toggle artifacts panel"
                            t-on-click="() => this.toggleArtifacts()"
                        >
                            <i class="oi" data-icon="attach_file"/>
                        </button>
                        <button
                            t-if="!session.readonly"
                            class="btn btn-link btn-sm mk_header_btn d-inline-flex align-items-center justify-content-center p-0 border-0 rounded-3"
                            title="Hand over this chat to another user"
                            t-on-click="() => session.openHandoverPicker()"
                        >
                            <i class="oi" data-icon="forward"/>
                        </button>
                        <button
                            class="btn btn-link btn-sm mk_header_btn d-none d-md-inline-flex align-items-center justify-content-center p-0 border-0 rounded-3"
                            title="Pop out chat to a floating window"
                            t-on-click="() => this.chat.openWindow(session.id)"
                        >
                            <i class="oi" data-icon="open_in_new"/>
                        </button>
                    </div>
                </t>
            </div>
            <div class="mk_chat_body d-flex flex-grow-1 position-relative">
                <t t-if="!this.state.sidebarHidden">
                    <ChatSidebar
                        activeId="this.state.sessionId or undefined"
                        onSelect.bind="this.select"
                        onNew.bind="this.newSession"
                    />
                    <div class="mk_sidebar_backdrop position-absolute top-0 start-0 w-100 h-100 cursor-pointer d-md-none" t-on-click="() => this.state.sidebarHidden = true"/>
                </t>
                <main class="mk_main d-flex flex-column flex-grow-1" t-ref="this.main">
                    <ChatSearch
                        t-if="this.state.searchOpen and session"
                        target="this.main"
                        onClose="() => this.state.searchOpen = false"
                    />
                    <div t-if="!this.state.ready" class="flex-grow-1 d-flex align-items-center justify-content-center text-muted">
                        <i class="oi oi-spin me-2" data-icon="progress_activity"/>Loading...
                    </div>
                    <div t-elif="!session" class="mk_empty flex-grow-1 d-flex flex-column align-items-center justify-content-center text-muted">
                        <div class="mk_empty_badge d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm text-white bg-primary lh-1">
                            <i class="oi" data-icon="forum"/>
                        </div>
                        <h2 class="fw-semibold mb-1 text-body">How can I help you today?</h2>
                        <p t-if="this.suggestions.length" class="mb-0">Start a new chat or pick a suggestion to begin.</p>
                        <p t-else="" class="mb-0">Start a new chat to begin.</p>
                        <t t-call="muk_ai.Suggestions" suggestions="this.suggestions" onPick="(prompt) => this.startWithPrompt(prompt)"/>
                    </div>
                    <ChatConversation
                        t-else=""
                        session="session"
                        placeholder="this.placeholder"
                        onForked.bind="this.select"
                    />
                </main>
                <ArtifactsPanel
                    t-if="!this.state.artifactsHidden and session"
                    session="session"
                    focus="this.state.focus or undefined"
                    onClose="() => this.state.artifactsHidden = true"
                />
            </div>
        </div>
    </t>

</templates>
