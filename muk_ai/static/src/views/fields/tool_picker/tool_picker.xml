<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.ToolPickerField">
        <div class="o_field_tags d-inline-flex flex-wrap gap-1 mw-100" t-att-class="{ 'o_tags_input o_input': !this.props.readonly }">
            <BadgeTag
                t-foreach="this.selected"
                t-as="name"
                t-key="name"
                text="name"
                color="this.color(name)"
                onDelete="this.props.readonly ? undefined : () => this.commit(this.selected.filter((item) => item !== name))"
            />
            <div t-if="!this.props.readonly" class="o_field_many2many_selection d-inline-flex flex-grow-1">
                <AutoComplete
                    value="''"
                    sources="this.sources"
                    placeholder="this.selected.length ? '' : this.props.placeholder or 'Add a tool...'"
                    resetOnSelect="true"
                    class="'o_input w-100'"
                />
            </div>
        </div>
    </t>

</templates>
