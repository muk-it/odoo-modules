<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai.PromptField" t-inherit="web.TextField" t-inherit-mode="primary">
        <xpath expr="//textarea" position="attributes">
            <attribute name="t-att-class">{
                'o_field_translate': this.isTranslatable,
                'o_field_placeholder': this.resModel,
            }</attribute>
        </xpath>
        <xpath expr="//button[@data-icon='wand_stars']" position="attributes">
            <attribute name="t-if">this.resModel</attribute>
        </xpath>
    </t>

</templates>
