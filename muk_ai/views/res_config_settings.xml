<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="inside">
				<app data-string="MuK AI" string="MuK AI" name="muk_ai">
					<block title="Defaults" name="muk_ai_settings_defaults">
						<setting
							id="muk_ai_default_provider"
							string="Default Provider"
							help="Provider whose default models serve an agent that picks none, before the other providers in list order."
						>
							<field name="ai_provider_id" options="{'no_create': True}"/>
						</setting>
						<setting
							id="muk_ai_default_agent"
							string="Default Agent"
							help="Agent used for new chat sessions when none is specified."
						>
							<field name="ai_agent_id" options="{'no_create': True}"/>
						</setting>
					</block>
					<block title="Web Search" name="muk_ai_settings_search">
						<setting
							id="muk_ai_search_backend"
							string="Search Backend"
							help="Search API the web_search tool queries on every provider. Leave empty to keep the provider's built-in search where it has one."
						>
							<field name="ai_search_backend" placeholder="Provider Built-in"/>
							<field name="ai_search_needs_key" invisible="1"/>
							<field name="ai_search_needs_url" invisible="1"/>
							<div class="text-muted mt8" invisible="ai_search_backend != 'searxng'">
								Self-hosted and free: no account and no API key. The instance
								must list <code>json</code> under <code>search.formats</code>,
								or it answers 403.
							</div>
						</setting>
						<setting
							id="muk_ai_search_credentials"
							string="Connection"
							help="Credentials for the selected backend. Only what that backend actually uses is asked for."
							invisible="not ai_search_backend"
						>
							<div class="content-group" invisible="not ai_search_needs_key">
								<label for="ai_search_api_key" string="API Key" class="o_light_label"/>
								<field name="ai_search_api_key" password="True" class="w-100"/>
							</div>
							<div class="content-group" invisible="not ai_search_needs_url">
								<label for="ai_search_url" string="Instance URL" class="o_light_label"/>
								<field name="ai_search_url" placeholder="http://searxng:8080" class="w-100"/>
							</div>
						</setting>
					</block>
					<block title="Limits" name="muk_ai_settings_limits">
						<setting id="muk_ai_max_iterations">
							<label string="Iteration Limit" for="ai_max_iterations"/>
							<div class="text-muted">
								The model is warned shortly before the limit so it can wrap up.							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max rounds" for="ai_max_iterations"/>
										<field name="ai_max_iterations" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">per Slice</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="muk_ai_turn_wallclock">
							<label string="Turn Runtime" for="ai_turn_wallclock_seconds"/>
							<div class="text-muted">
								A user turn exceeding this across all slices stops with an error.							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="ai_turn_wallclock_seconds"/>
										<field name="ai_turn_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Seconds</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="muk_ai_slice_wallclock">
							<label string="Slice Runtime" for="ai_slice_wallclock_seconds"/>
							<div class="text-muted">
								A worker slice exceeding this is checkpointed and resumed by a fresh worker.							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="ai_slice_wallclock_seconds"/>
										<field name="ai_slice_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Seconds</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="muk_ai_turn_cost_limit">
							<label string="Cost Limit" for="ai_turn_cost_limit"/>
							<div class="text-muted">
								Maximum spend per user turn in the model's price currency. Set to 0 to disable.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_turn_cost_limit"/>
										<field name="ai_turn_cost_limit" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">per Turn</span>
									</div>
								</div>
							</div>
						</setting>
					</block>
					<block title="Budget" name="muk_ai_settings_budget">
						<setting
							id="muk_ai_monthly_budget"
							string="Monthly Budget"
							help="Maximum spend per calendar month in the model's price currency. A user's own budget replaces the one per user. Set to 0 to disable."
						>
							<div class="content-group">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_monthly_budget"/>
										<field name="ai_monthly_budget" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Total</span>
									</div>
								</div>
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_user_monthly_budget"/>
										<field name="ai_user_monthly_budget" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">per User</span>
									</div>
								</div>
							</div>
						</setting>
						<setting
							id="muk_ai_usage_retention"
							string="Delete Old Usage"
							help="Delete the AI usage of past months. The monthly budgets only count the current month."
						>
							<div class="content-group">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Keep Usage for" for="ai_usage_retention_months"/>
										<field name="ai_usage_retention_months" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">Months</span>
									</div>
								</div>
							</div>
						</setting>
					</block>
					<block title="Housekeeping" name="muk_ai_settings_autovacuum">
						<setting
							id="muk_ai_client_action_timeout"
							string="Give Up on Stale Actions"
							help="Answer for a browser that never carried out an action a chat asked for, so the turn is not left waiting for good."
						>
							<div class="content-group">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Wait for" for="ai_client_action_timeout"/>
										<field name="ai_client_action_timeout" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">Seconds</span>
									</div>
								</div>
							</div>
						</setting>
						<setting
							id="muk_ai_session_retention"
							string="Delete Old Chats"
							help="Delete finished chats once they are old enough. A chat that is still running is never touched."
						>
							<field name="ai_session_retention_enabled"/>
							<div class="content-group mt16" invisible="not ai_session_retention_enabled">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Keep Chats for" for="ai_session_retention_days"/>
										<field name="ai_session_retention_days" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">Days</span>
									</div>
								</div>
							</div>
						</setting>
					</block>
					<block title="MCP Server" name="muk_ai_mcp_settings">
						<setting id="muk_ai_mcp_session_timeout">
							<label string="Session Timeout" for="mcp_session_timeout"/>
							<div class="text-muted">
								Inactive sessions are cleaned up after this period.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="mcp_session_timeout"/>
										<field name="mcp_session_timeout" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Hours</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="muk_ai_mcp_log_retention">
							<label string="Log Retention" for="mcp_log_retention"/>
							<div class="text-muted">
								Audit logs older than this period are automatically deleted.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Retention" for="mcp_log_retention"/>
										<field name="mcp_log_retention" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">in Days</span>
									</div>
								</div>
							</div>
						</setting>
						<setting id="muk_ai_mcp_rate_limit">
							<label string="Rate Limiting" for="mcp_rate_limit_requests"/>
							<div class="text-muted">
								Default rate limit for new API keys. Set to 0 to disable.
							</div>
							<div class="content-group mt16">
								<div class="row">
									<div class="o_light_label">
										<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max requests" for="mcp_rate_limit_requests"/>
										<field name="mcp_rate_limit_requests" class="w-25 text-center" nolabel="1"/>
										<span class="col-auto ms-2">per Minute</span>
									</div>
								</div>
							</div>
						</setting>
						<setting
							id="muk_ai_mcp_annotate_messages"
							string="Annotate Messages"
							help="Mark chatter messages originating from MCP."
						>
							<field name="mcp_annotate_messages"/>
							<button
								name="%(muk_mcp.action_connect)d"
								type="action"
								string="Connect AI"
								icon="oi-arrow-right"
								class="btn-link mt-3"
							/>
						</setting>
					</block>
					<block title="Extensions" name="muk_ai_extensions">
						<setting
							id="muk_ai_addon_compat"
							string="Compatible Providers"
							help="Ollama, vLLM, OpenRouter and any OpenAI-compatible LLM."
						>
							<field
								name="module_muk_ai_compat"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_compat" id="msg_module_muk_ai_compat">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_mistral"
							string="Mistral"
							help="Mistral Large, Medium, Small, Ministral and Codestral."
						>
							<field
								name="module_muk_ai_mistral"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_mistral" id="msg_module_muk_ai_mistral">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_skills"
							string="Skills"
							help="Pre-built agent skills the user or LLM can switch into."
						>
							<field
								name="module_muk_ai_skills"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_skills" id="msg_module_muk_ai_skills">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_subagents"
							string="Subagents"
							help="Delegate work to focused agents that run in parallel."
						>
							<field
								name="module_muk_ai_subagents"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_subagents" id="msg_module_muk_ai_subagents">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_mcp"
							string="MCP"
							help="Connect remote MCP servers whose tools agents can call."
						>
							<field
								name="module_muk_ai_mcp"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_mcp" id="msg_module_muk_ai_mcp">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_voice"
							string="Voice"
							help="Talk to the assistant and hear it answer."
						>
							<field
								name="module_muk_ai_voice"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_voice" id="msg_module_muk_ai_voice">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_chatter"
							string="Chatter"
							help="Mention agents in Discuss and write messages with AI."
						>
							<field
								name="module_muk_ai_chatter"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_chatter" id="msg_module_muk_ai_chatter">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_decision"
							string="Decision Models"
							help="Typed choices, scores and yes/no answers in a second."
						>
							<field
								name="module_muk_ai_decision"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_decision" id="msg_module_muk_ai_decision">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_automation"
							string="Automation"
							help="Run agents from server actions and automation rules."
						>
							<field
								name="module_muk_ai_automation"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_automation" id="msg_module_muk_ai_automation">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_schedule"
							string="Schedule"
							help="Let agents wait for a time, a change or a reply."
						>
							<field
								name="module_muk_ai_schedule"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_schedule" id="msg_module_muk_ai_schedule">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_rag"
							string="Knowledge"
							help="Agents answer from your documents and cite their sources."
						>
							<field
								name="module_muk_ai_rag"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_rag" id="msg_module_muk_ai_rag">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_memory"
							string="Memory"
							help="The assistant remembers how you work, and shows it."
						>
							<field
								name="module_muk_ai_memory"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_memory" id="msg_module_muk_ai_memory">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_workflows"
							string="Workflows"
							help="Multi-step AI playbooks and stateful business processes."
						>
							<field
								name="module_muk_ai_workflows"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_workflows" id="msg_module_muk_ai_workflows">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
					</block>
					<block title="Integrations" name="muk_ai_integrations">
						<setting
							id="muk_ai_addon_spreadsheets"
							string="Dashboards"
							help="Build and edit spreadsheet dashboards in a chat."
						>
							<field
								name="module_muk_ai_spreadsheets"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_spreadsheets" id="msg_module_muk_ai_spreadsheets">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_website"
							string="Website"
							help="Build website pages live in the builder, in a chat."
						>
							<field
								name="module_muk_ai_website"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_website" id="msg_module_muk_ai_website">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_livechat"
							string="Live Chat"
							help="Answer website visitors in the live chat."
						>
							<field
								name="module_muk_ai_livechat"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_livechat" id="msg_module_muk_ai_livechat">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_mass_mailing"
							string="Email Marketing"
							help="Design newsletters that render in every mail client."
						>
							<field
								name="module_muk_ai_mass_mailing"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_mass_mailing" id="msg_module_muk_ai_mass_mailing">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
						<setting
							id="muk_ai_addon_crm"
							string="CRM"
							help="Research leads, draft quotations and follow them up."
						>
							<field
								name="module_muk_ai_crm"
								widget="module_link"
							/>
							<div class="content-group" invisible="not module_muk_ai_crm" id="msg_module_muk_ai_crm">
								<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
							</div>
						</setting>
					</block>
				</app>
			</xpath>
		</field>
	</record>

	<record id="action_muk_ai_config_settings" model="ir.actions.act_window">
		<field name="name">Settings</field>
		<field name="res_model">res.config.settings</field>
		<field name="view_mode">form</field>
		<field name="context">{'module': 'muk_ai', 'bin_size': False}</field>
	</record>

</odoo>
