<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//div[hasclass('settings')]" position="inside">
				<div class="app_settings_block" data-string="MuK AI" string="MuK AI" data-key="muk_ai">
					<h2>Defaults</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_settings_defaults">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_default_provider">
							<div class="o_setting_right_pane">
								<label for="ai_provider_id" string="Default Provider"/>
								<div class="text-muted">
									Provider whose default models serve an agent that picks none, before the other providers in list order.
								</div>
								<div class="content-group mt16">
									<field name="ai_provider_id" options="{'no_create': True}"/>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_default_agent">
							<div class="o_setting_right_pane">
								<label for="ai_agent_id" string="Default Agent"/>
								<div class="text-muted">
									Agent used for new chat sessions when none is specified.
								</div>
								<div class="content-group mt16">
									<field name="ai_agent_id" options="{'no_create': True}"/>
								</div>
							</div>
						</div>
					</div>
					<h2>Budget</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_settings_budget">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_monthly_budget">
							<div class="o_setting_right_pane">
								<label for="ai_monthly_budget" string="Monthly Budget"/>
								<div class="text-muted">
									Maximum spend per calendar month in the model's price currency. A user's own budget replaces the one per user. Set to 0 to disable.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_monthly_budget"/>
											<field name="ai_monthly_budget" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Total</span>
										</div>
									</div>
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_user_monthly_budget"/>
											<field name="ai_user_monthly_budget" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">per User</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_usage_retention">
							<div class="o_setting_right_pane">
								<label for="ai_usage_retention_months" string="Delete Old Usage"/>
								<div class="text-muted">
									Delete the AI usage of past months. The monthly budgets only count the current month.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Keep Usage for" for="ai_usage_retention_months"/>
											<field name="ai_usage_retention_months" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">Months</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<h2>Web Search</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_settings_search">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_search_backend">
							<div class="o_setting_right_pane">
								<label for="ai_search_backend" string="Search Backend"/>
								<div class="text-muted">
									Search API the web_search tool queries on every provider. Leave empty to keep the provider's built-in search where it has one.
								</div>
								<div class="content-group mt16">
									<field name="ai_search_backend" placeholder="Provider Built-in"/>
									<field name="ai_search_needs_key" invisible="1"/>
									<field name="ai_search_needs_url" invisible="1"/>
									<div class="text-muted mt8" attrs="{'invisible': [('ai_search_backend', '!=', 'searxng')]}">
										Self-hosted and free: no account and no API key. The instance
										must list <code>json</code> under <code>search.formats</code>,
										or it answers 403.
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_search_credentials" attrs="{'invisible': [('ai_search_backend', '=', False)]}">
							<div class="o_setting_right_pane">
								<span class="o_form_label">Connection</span>
								<div class="text-muted">
									Credentials for the selected backend. Only what that backend actually uses is asked for.
								</div>
								<div class="content-group mt16" attrs="{'invisible': [('ai_search_needs_key', '=', False)]}">
									<label for="ai_search_api_key" string="API Key" class="o_light_label"/>
									<field name="ai_search_api_key" password="True" class="w-100"/>
								</div>
								<div class="content-group mt16" attrs="{'invisible': [('ai_search_needs_url', '=', False)]}">
									<label for="ai_search_url" string="Instance URL" class="o_light_label"/>
									<field name="ai_search_url" placeholder="http://searxng:8080" class="w-100"/>
								</div>
							</div>
						</div>
					</div>
					<h2>Limits</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_settings_limits">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_max_iterations">
							<div class="o_setting_right_pane">
								<label string="Iteration Limit" for="ai_max_iterations"/>
								<div class="text-muted">
									The model is warned shortly before the limit so it can wrap up.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max rounds" for="ai_max_iterations"/>
											<field name="ai_max_iterations" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">per Slice</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_turn_wallclock">
							<div class="o_setting_right_pane">
								<label string="Turn Runtime" for="ai_turn_wallclock_seconds"/>
								<div class="text-muted">
									A user turn exceeding this across all slices stops with an error.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="ai_turn_wallclock_seconds"/>
											<field name="ai_turn_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Seconds</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_slice_wallclock">
							<div class="o_setting_right_pane">
								<label string="Slice Runtime" for="ai_slice_wallclock_seconds"/>
								<div class="text-muted">
									A worker slice exceeding this is checkpointed and resumed by a fresh worker.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="ai_slice_wallclock_seconds"/>
											<field name="ai_slice_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Seconds</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_turn_cost_limit">
							<div class="o_setting_right_pane">
								<label string="Cost Limit" for="ai_turn_cost_limit"/>
								<div class="text-muted">
									Maximum spend per user turn in the model's price currency. Set to 0 to disable.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_turn_cost_limit"/>
											<field name="ai_turn_cost_limit" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">per Turn</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<h2>Housekeeping</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_settings_autovacuum">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_client_action_timeout">
							<div class="o_setting_right_pane">
								<label for="ai_client_action_timeout" string="Give Up on Stale Actions"/>
								<div class="text-muted">
									Answer for a browser that never carried out an action a chat asked for, so the turn is not left waiting for good.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Wait for" for="ai_client_action_timeout"/>
											<field name="ai_client_action_timeout" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">Seconds</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_session_retention">
							<div class="o_setting_left_pane">
								<field name="ai_session_retention_enabled"/>
							</div>
							<div class="o_setting_right_pane">
								<label for="ai_session_retention_enabled" string="Delete Old Chats"/>
								<div class="text-muted">
									Delete finished chats once they are old enough. A chat that is still running is never touched.
								</div>
								<div class="content-group mt16" attrs="{'invisible': [('ai_session_retention_enabled', '=', False)]}">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Keep Chats for" for="ai_session_retention_days"/>
											<field name="ai_session_retention_days" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">Days</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<h2>MCP Server</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_mcp_settings">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_session_timeout">
							<div class="o_setting_right_pane">
								<label string="Session Timeout" for="mcp_session_timeout"/>
								<div class="text-muted">
									Inactive sessions are cleaned up after this period.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="mcp_session_timeout"/>
											<field name="mcp_session_timeout" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Hours</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_log_retention">
							<div class="o_setting_right_pane">
								<label string="Log Retention" for="mcp_log_retention"/>
								<div class="text-muted">
									Audit logs older than this period are automatically deleted.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Retention" for="mcp_log_retention"/>
											<field name="mcp_log_retention" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Days</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_rate_limit">
							<div class="o_setting_right_pane">
								<label string="Rate Limiting" for="mcp_rate_limit_requests"/>
								<div class="text-muted">
									Default rate limit for new API keys. Set to 0 to disable.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="col-6 col-sm-4 col-md-2 col-lg-4" string="Max requests" for="mcp_rate_limit_requests"/>
											<field name="mcp_rate_limit_requests" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">per Minute</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_annotate_messages">
							<div class="o_setting_left_pane">
								<field name="mcp_annotate_messages"/>
							</div>
							<div class="o_setting_right_pane">
								<label for="mcp_annotate_messages" string="Annotate Messages"/>
								<div class="text-muted">
									Mark chatter messages originating from MCP.
								</div>
							</div>
						</div>
					</div>
					<h2>Extensions</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_extensions">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_addon_browser">
							<div class="o_setting_left_pane">
								<field name="module_muk_ai_browser"/>
							</div>
							<div class="o_setting_right_pane">
								<label for="module_muk_ai_browser" string="Browser"/>
								<div class="text-muted">
									Agents read and act on the web pages in your browser.
								</div>
								<div class="content-group" attrs="{'invisible': [('module_muk_ai_browser', '=', False)]}" id="msg_module_muk_ai_browser">
									<div class="mt16 text-warning"><strong>Save</strong> this page and come back here to set up the feature.</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</xpath>
		</field>
	</record>

	<record id="action_muk_ai_config_settings" model="ir.actions.act_window">
		<field name="name">Settings</field>
		<field name="res_model">res.config.settings</field>
		<field name="view_mode">form</field>
		<field name="context">{'module': 'muk_ai', 'bin_size': False}</field>
	</record>

</odoo>
