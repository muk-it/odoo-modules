<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//div[hasclass('settings')]" position="inside">
				<div class="app_settings_block" data-string="MuK AI" string="MuK AI" data-key="muk_ai">
					<h2>MuK AI</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_settings">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_default_provider">
							<div class="o_setting_right_pane">
								<label for="ai_provider_id" string="Default Provider"/>
								<div class="text-muted">
									Provider used when an agent does not specify one.
								</div>
								<div class="content-group mt16">
									<field name="ai_provider_id" options="{'no_create': True}"/>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_default_agent">
							<div class="o_setting_right_pane">
								<label for="ai_agent_id" string="Default Agent"/>
								<div class="text-muted">
									Agent used for new chat sessions when none is specified.
								</div>
								<div class="content-group mt16">
									<field name="ai_agent_id" options="{'no_create': True}"/>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_max_iterations">
							<div class="o_setting_right_pane">
								<label string="Iteration Limit" for="ai_max_iterations"/>
								<div class="text-muted">
									The model is warned shortly before the limit so it can wrap up.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Max rounds" for="ai_max_iterations"/>
											<field name="ai_max_iterations" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">per Slice</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_turn_wallclock">
							<div class="o_setting_right_pane">
								<label string="Turn Runtime" for="ai_turn_wallclock_seconds"/>
								<div class="text-muted">
									A user turn exceeding this across all slices stops with an error.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="ai_turn_wallclock_seconds"/>
											<field name="ai_turn_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Seconds</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_slice_wallclock">
							<div class="o_setting_right_pane">
								<label string="Slice Runtime" for="ai_slice_wallclock_seconds"/>
								<div class="text-muted">
									A worker slice exceeding this is checkpointed and resumed by a fresh worker.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="ai_slice_wallclock_seconds"/>
											<field name="ai_slice_wallclock_seconds" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Seconds</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_turn_cost_limit">
							<div class="o_setting_right_pane">
								<label string="Cost Limit" for="ai_turn_cost_limit"/>
								<div class="text-muted">
									Maximum spend per user turn in the model's price currency. Set to 0 to disable.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Max spend" for="ai_turn_cost_limit"/>
											<field name="ai_turn_cost_limit" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">per Turn</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<h2>Housekeeping</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_settings_autovacuum">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_client_action_timeout">
							<div class="o_setting_right_pane">
								<label string="Give Up on Stale Actions" for="ai_client_action_timeout"/>
								<div class="text-muted">
									Answer for a browser that never carried out an action a chat asked for, so the turn is not left waiting for good.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Wait for" for="ai_client_action_timeout"/>
											<field name="ai_client_action_timeout" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">Seconds</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_session_retention">
							<div class="o_setting_left_pane">
								<field name="ai_session_retention_enabled"/>
							</div>
							<div class="o_setting_right_pane">
								<label string="Delete Old Chats" for="ai_session_retention_enabled"/>
								<div class="text-muted">
									Delete finished chats once they are old enough. A chat that is still running is never touched.
								</div>
								<div class="content-group mt16" attrs="{'invisible': [('ai_session_retention_enabled', '=', False)]}">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Keep Chats for" for="ai_session_retention_days"/>
											<field name="ai_session_retention_days" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">Days</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					<h2>MCP Server</h2>
					<div class="row mt16 o_settings_container" name="muk_ai_mcp_settings">
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_session_timeout">
							<div class="o_setting_right_pane">
								<label string="Session Timeout" for="mcp_session_timeout"/>
								<div class="text-muted">
									Inactive sessions are cleaned up after this period.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Timeout" for="mcp_session_timeout"/>
											<field name="mcp_session_timeout" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Hours</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_log_retention">
							<div class="o_setting_right_pane">
								<label string="Log Retention" for="mcp_log_retention"/>
								<div class="text-muted">
									Audit logs older than this period are automatically deleted.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Retention" for="mcp_log_retention"/>
											<field name="mcp_log_retention" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">in Days</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_rate_limit">
							<div class="o_setting_right_pane">
								<label string="Rate Limiting" for="mcp_rate_limit_requests"/>
								<div class="text-muted">
									Default rate limit for new API keys. Set to 0 to disable.
								</div>
								<div class="content-group mt16">
									<div class="row">
										<div class="o_light_label">
											<label class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4" string="Max requests" for="mcp_rate_limit_requests"/>
											<field name="mcp_rate_limit_requests" class="w-25 text-center" nolabel="1"/>
											<span class="col-auto ms-2">per Minute</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="col-12 col-lg-6 o_setting_box" id="muk_ai_mcp_annotate_messages">
							<div class="o_setting_left_pane">
								<field name="mcp_annotate_messages"/>
							</div>
							<div class="o_setting_right_pane">
								<label for="mcp_annotate_messages" string="Annotate Messages"/>
								<div class="text-muted">
									Mark chatter messages originating from MCP.
								</div>
								<div class="content-group mt16">
									<button
										name="%(muk_mcp.action_connect)d"
										type="action"
										string="Connect AI"
										icon="fa-arrow-right"
										class="btn-link"
									/>
								</div>
							</div>
						</div>
					</div>
				</div>
			</xpath>
		</field>
	</record>

	<record id="action_muk_ai_config_settings" model="ir.actions.act_window">
		<field name="name">Settings</field>
		<field name="res_model">res.config.settings</field>
		<field name="view_mode">form</field>
		<field name="context">{'module': 'muk_ai', 'bin_size': False}</field>
	</record>

</odoo>
