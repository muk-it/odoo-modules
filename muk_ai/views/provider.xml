<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_muk_ai_provider_search" model="ir.ui.view">
		<field name="name">muk_ai.provider.search</field>
		<field name="model">muk_ai.provider</field>
		<field name="arch" type="xml">
			<search>
				<field name="name"/>
				<filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
			</search>
		</field>
	</record>

	<record id="view_muk_ai_provider_list" model="ir.ui.view">
		<field name="name">muk_ai.provider.list</field>
		<field name="model">muk_ai.provider</field>
		<field name="arch" type="xml">
			<tree>
				<field name="sequence" widget="handle"/>
				<field name="name"/>
				<field name="code"/>
				<field name="default_chat_model_id"/>
				<field name="max_tokens"/>
				<field name="request_timeout"/>
				<field name="rate_limit"/>
				<field name="active" widget="boolean_toggle"/>
			</tree>
		</field>
	</record>

	<record id="view_muk_ai_provider_form" model="ir.ui.view">
		<field name="name">muk_ai.provider.form</field>
		<field name="model">muk_ai.provider</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button
                        name="action_test_connection"
                        type="object"
                        string="Test Connection"
                        class="btn-primary"
                    />
				</header>
				<sheet>
					<field name="active" invisible="1"/>
					<widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
					<div class="oe_title">
						<label for="name"/>
						<h1>
							<field name="name" readonly="id"/>
						</h1>
						<h3 invisible="id and code == 'default'">
							<field name="code" placeholder="default"/>
						</h3>
					</div>
					<group>
						<group string="Connection">
							<field name="api_key" password="True"/>
							<field name="model_modalities" invisible="1"/>
							<field
                                name="default_chat_model_id"
                                options="{'no_create': True}"
                                invisible="'chat' not in (model_modalities or [])"
                            />
							<field
                                name="default_image_model_id"
                                options="{'no_create': True}"
                                invisible="'image' not in (model_modalities or [])"
                            />
							<field name="api_region_options" invisible="1"/>
							<field
                                name="api_region"
                                widget="filtered_selection"
                                options="{'options_field': 'api_region_options'}"
                                invisible="not api_region_options"
                            />
							<field
                                name="api_url"
                                invisible="api_region != 'custom'"
                                required="api_region == 'custom'"
                                placeholder="https://my-resource.openai.azure.com/openai/v1"
                            />
							<field
                                name="api_endpoint"
                                invisible="not api_region_options"
                            />
						</group>
						<group string="Limits">
							<field name="max_tokens"/>
							<label for="request_timeout"/>
							<div class="d-flex align-items-center gap-2">
								<field name="request_timeout" class="flex-grow-1"/>
								<span>Seconds</span>
							</div>
							<label for="idle_timeout"/>
							<div class="d-flex align-items-center gap-2">
								<field name="idle_timeout" class="flex-grow-1"/>
								<span>Seconds</span>
							</div>
							<label for="image_timeout"/>
							<div class="d-flex align-items-center gap-2">
								<field name="image_timeout" class="flex-grow-1"/>
								<span>Seconds</span>
							</div>
							<label for="rate_limit"/>
							<div class="d-flex align-items-center gap-2">
								<field name="rate_limit" class="flex-grow-1"/>
								<span class="text-nowrap">/ Minute</span>
							</div>
						</group>
					</group>
					<notebook>
						<page string="Models" name="models">
							<field name="model_ids" context="{'default_provider_id': id}">
								<tree>
									<field name="sequence" widget="handle"/>
									<field name="name"/>
									<field name="technical_name"/>
									<field name="modality"/>
									<field name="context_window" invisible="modality != 'chat'"/>
									<field name="rate_unit"/>
									<field name="input_rate"/>
									<field name="output_rate" invisible="modality not in ('chat', 'image')"/>
									<field name="cache_read_rate" invisible="modality != 'chat'"/>
									<field name="cache_write_rate" invisible="modality != 'chat'"/>
									<field name="active" widget="boolean_toggle"/>
								</tree>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_muk_ai_provider" model="ir.actions.act_window">
		<field name="name">AI Providers</field>
		<field name="res_model">muk_ai.provider</field>
		<field name="view_mode">tree,form</field>
	</record>

</odoo>
