<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_users_list_budget" model="ir.ui.view">
		<field name="name">res.users.list.budget</field>
		<field name="model">res.users</field>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<tree string="Budgets" editable="bottom" create="false" delete="false">
				<field name="name" readonly="1"/>
				<field name="login" readonly="1"/>
				<field name="ai_monthly_budget"/>
			</tree>
		</field>
	</record>

	<record id="view_res_users_search_handover" model="ir.ui.view">
		<field name="name">res.users.search.handover</field>
		<field name="model">res.users</field>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<search>
				<field
                    name="name"
                    string="User"
                    filter_domain="['|', ('name', 'ilike', self), ('email', 'ilike', self)]"
                />
			</search>
		</field>
	</record>

	<record id="view_res_users_kanban_handover" model="ir.ui.view">
		<field name="name">res.users.kanban.handover</field>
		<field name="model">res.users</field>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<kanban create="false">
				<field name="id"/>
				<field name="name"/>
				<field name="email"/>
				<templates>
					<t t-name="kanban-box">
						<div class="oe_kanban_global_click">
							<div class="d-flex align-items-center gap-2">
								<div>
									<img
                                        t-attf-src="/web/image/res.users/{{record.id.raw_value}}/avatar_128"
                                        alt="User"
                                        class="o_avatar rounded"
                                        style="width: 40px; height: 40px; object-fit: cover;"
                                    />
								</div>
								<div class="overflow-hidden">
									<field name="name" class="fw-bold text-truncate d-block"/>
									<field name="email" class="text-muted small text-truncate d-block"/>
								</div>
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_res_users_list_handover" model="ir.ui.view">
		<field name="name">res.users.list.handover</field>
		<field name="model">res.users</field>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<tree string="Users" create="false" edit="false" delete="false">
				<field
                    name="avatar_128"
                    widget="image"
                    options="{'size': [24, 24], 'img_class': 'o_avatar rounded'}"
                    width="30"
                    nolabel="1"
                />
				<field name="name"/>
				<field name="email"/>
			</tree>
		</field>
	</record>

	<record id="action_res_users_budget" model="ir.actions.act_window">
		<field name="name">Budgets</field>
		<field name="res_model">res.users</field>
		<field name="view_mode">tree</field>
		<field name="view_id" ref="view_res_users_list_budget"/>
		<field name="domain">[('share', '=', False)]</field>
	</record>

</odoo>
