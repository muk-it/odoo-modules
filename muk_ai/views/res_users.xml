<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_users_search_handover" model="ir.ui.view">
		<field name="name">res.users.search.handover</field>
		<field name="model">res.users</field>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<search>
				<field
                    name="name"
                    string="User"
                    filter_domain="['|', ('name', 'ilike', self), ('email', 'ilike', self)]"
                />
			</search>
		</field>
	</record>

	<record id="view_res_users_kanban_handover" model="ir.ui.view">
		<field name="name">res.users.kanban.handover</field>
		<field name="model">res.users</field>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<kanban create="false">
				<field name="id"/>
				<field name="name"/>
				<field name="email"/>
				<templates>
					<t t-name="card">
						<div class="d-flex align-items-center gap-2">
							<aside>
								<img
                                    t-attf-src="/web/image/res.users/{{record.id.raw_value}}/avatar_128"
                                    alt="User"
                                    class="o_avatar rounded"
                                    style="width: 40px; height: 40px; object-fit: cover;"
                                />
							</aside>
							<main class="overflow-hidden">
								<field name="name" class="fw-bold text-truncate d-block"/>
								<field name="email" class="text-muted small text-truncate d-block"/>
							</main>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>

	<record id="view_res_users_list_handover" model="ir.ui.view">
		<field name="name">res.users.list.handover</field>
		<field name="model">res.users</field>
		<field name="priority">99</field>
		<field name="arch" type="xml">
			<list string="Users" create="false" edit="false" delete="false">
				<field
                    name="avatar_128"
                    widget="image"
                    options="{'size': [24, 24], 'img_class': 'o_avatar rounded'}"
                    width="30"
                    nolabel="1"
                />
				<field name="name"/>
				<field name="email"/>
			</list>
		</field>
	</record>

</odoo>
