<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="action_ai_agent_product_writer" model="ir.actions.act_window">
		<field name="name">Product Content Writer</field>
		<field name="res_model">muk_ai.agent</field>
		<field name="view_mode">form</field>
		<field name="res_id" ref="agent_product_writer"/>
	</record>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai_product</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="muk_ai.view_res_config_settings_form"/>
		<field name="arch" type="xml">
			<data>
				<xpath expr="//div[@id='msg_module_muk_ai_product']" position="replace">
					<div
						class="content-group"
						invisible="not module_muk_ai_product"
						id="msg_module_muk_ai_product"
					>
						<div class="mt16">
							<button
								name="%(action_ai_agent_product_writer)d"
								type="action"
								string="Open Product Content Writer"
								icon="arrow_forward"
								class="btn-link"
							/>
						</div>
					</div>
				</xpath>
			</data>
		</field>
	</record>

</odoo>
