<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="view_res_config_settings_skills" model="ir.ui.view">
        <field name="name">res.config.settings.muk_mcp_skills</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="muk_mcp.view_res_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='msg_module_muk_mcp_skills']" position="replace">
                <div
                    class="content-group"
                    invisible="not module_muk_mcp_skills"
                    id="msg_module_muk_mcp_skills"
                >
                    <div class="mt16">
                        <button
                            name="%(action_skill)d"
                            type="action"
                            string="Manage Skills"
                            icon="arrow_forward"
                            class="btn-link"
                        />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
