<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <record id="rule_skill_user" model="ir.rule">
        <field name="name">Users read the MCP skills of their groups</field>
        <field name="model_id" ref="model_muk_mcp_skills_skill"/>
        <field name="domain_force">['|', ('group_ids', '=', False), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="rule_skill_system" model="ir.rule">
        <field name="name">Administrators manage MCP skills</field>
        <field name="model_id" ref="model_muk_mcp_skills_skill"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

</odoo>
