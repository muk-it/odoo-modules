<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_access" model="ir.ui.view">
		<field name="name">res.config.settings.muk_mcp_access</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="muk_mcp.view_res_config_settings_form"/>
		<field name="arch" type="xml">
			<xpath expr="//block[@name='mcp_settings']" position="inside">
				<setting
					id="mcp_access_models_setting"
					string="Model Access"
					help="Restrict which models AI agents can reach via MCP."
				>
					<button
						name="%(muk_mcp_access.action_mcp_access_model)d"
						type="action"
						string="Manage Model Access"
						icon="oi-arrow-right"
						class="btn-link"
					/>
				</setting>
			</xpath>
		</field>
	</record>

</odoo>
