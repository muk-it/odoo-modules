<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai_enterprise.Systray" t-inherit="muk_ai.Systray" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mk_systray_top')]" position="inside">
            <button
                class="btn btn-light btn-sm mk_systray_odoo_ai"
                t-att-title="`Open Odoo AI (${odooAIHotkeyLabel})`"
                t-on-click="() => this.onOpenOdooAI()"
            >
                <img class="mk_systray_odoo_ai_icon" src="/ai/static/description/icon.png" alt="Odoo AI"/>
            </button>
        </xpath>
    </t>

</templates>
