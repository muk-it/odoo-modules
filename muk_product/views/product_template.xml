<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_template_search" model="ir.ui.view">
        <field name="name">product.template.search.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">
                    [
                        '|', '|', '|', '|', '|',
                        ('default_code', 'ilike', self),
                        ('product_variant_ids.default_code', 'ilike', self),
                        ('name', 'ilike', self),
                        ('barcode', 'ilike', self),
                        ('display_name', '=', self),
                        ('product_variant_ids.manufacturer_code', 'ilike', self)
                    ]
                </attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="manufacturer_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_panel_search" model="ir.ui.view">
        <field name="name">product.template.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <searchpanel>
                    <field
                        name="company_id"
                        groups="base.group_multi_company"
                        icon="business"
                    />
                    <field name="categ_id" icon="filter_alt" icon_class="oi-filled"/>
                    <field name="type" icon="category"/>
                    <field
                        name="product_tag_ids"
                        string="Tags"
                        icon="sell"
                        select="multi"
                    />
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_kanban" model="ir.ui.view">
        <field name="name">product.template.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="js_class">product_search_kanban</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_list" model="ir.ui.view">
        <field name="name">product.template.list</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="priority">900</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">product_list</attribute>
                <attribute name="js_class">product_search_list</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <xpath expr="//field[@name='type']" position="move"/>
                <field
                    name="image_1920"
                    widget="image"
                    nolabel="1"
                    width="30"
                    options="{'zoom': true, 'preview_image':'image_128', 'size': [25, 25]}"
                />
                <field
                    name="description"
                    nolabel="1"
                    widget="text_icon"
                    optional="show"
                />
            </xpath>
            <xpath expr="//field[@name='type']" position="attributes">
                <attribute name="nolabel">1</attribute>
                <attribute name="widget">selection_icons</attribute>
                <attribute name="options">
                    {
                        'icons': {
                            'consu': 'inventory_2',
                            'service': 'person',
                            'combo': 'account_tree',
                        },
                        'defaultIcon': 'settings',
                    }
                </attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='list_price']" position="before">
                <field name="manufacturer_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='internal_notes']" position="before">
                <group
                    name="manufacturer"
                    string="Manufacturer"
                    invisible="type in ['service', 'combo']"
                >
                    <group>
                        <field
                            name="manufacturer_id"
                            context="{'res_partner_search_mode': 'supplier'}"
                        />
                        <field name="manufacturer_name" string="Product Name"/>
                    </group>
                    <group>
                        <field
                            name="manufacturer_code"
                            string="Product Code"
                            invisible="product_variant_count &gt; 1"
                        />
                        <field
                            name="manufacturer_url"
                            widget="url"
                            string="Product URL"
                        />
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_product_template" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="path">product-templates</field>
        <field name="explanation">Opens all products with a search panel by company, category, type and tag. Use this when the user wants to browse, find or edit products, or bulk search them by reference, name or barcode.</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="search_view_id" ref="view_product_template_panel_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p>
            <p>
                Products carry their references, barcodes, prices and manufacturer.
            </p>
        </field>
    </record>

</odoo>
