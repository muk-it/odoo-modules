<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_product_panel_search" model="ir.ui.view">
        <field name="name">product.product.search</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//group" position="after">
                <searchpanel>
                    <field
                        name="company_id"
                        groups="base.group_multi_company"
                        icon="business"
                    />
                    <field name="categ_id" icon="filter_alt" icon_class="oi-filled"/>
                    <field name="type" icon="category"/>
                    <field
                        name="product_template_attribute_value_ids"
                        string="Attributes"
                        icon="view_list"
                        domain="[('ptav_active', '=', True), ('product_tmpl_id.active', '=', True)]"
                        select="multi"
                    />
                    <field
                        name="product_tag_ids"
                        string="Tags"
                        icon="sell"
                        select="multi"
                    />
                </searchpanel>
            </xpath>
        </field>
    </record>

    <record id="view_product_list" model="ir.ui.view">
        <field name="name">product.product.list</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="priority">900</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class">product_list</attribute>
            </xpath>
            <xpath expr="//field[@name='image_128']" position="before">
                <field
                    name="type"
                    nolabel="1"
                    readonly="1"
                    widget="selection_icons"
                    optional="show"
                    options="{
                        'icons': {
                            'consu': 'inventory_2',
                            'service': 'person',
                            'combo': 'account_tree',
                        },
                        'defaultIcon': 'settings',
                    }"
                />
            </xpath>
            <xpath expr="//field[@name='image_128']" position="after">
                <field
                    name="description"
                    nolabel="1"
                    widget="text_icon"
                    optional="show"
                />
            </xpath>
        </field>
    </record>

    <record id="view_product_normal_form" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='manufacturer_code']" position="attributes">
                <attribute name="invisible"/>
            </xpath>
        </field>
    </record>

    <record id="action_product" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="path">product-variants</field>
        <field name="explanation">Opens all product variants with a search panel by company, category, type, attribute and tag. Use this when the user wants to find or edit a specific variant, its reference, barcode or price.</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form,kanban,activity</field>
        <field name="search_view_id" ref="view_product_panel_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product variant
            </p>
            <p>
                Variants are generated from the attributes of a product.
            </p>
        </field>
    </record>

</odoo>
