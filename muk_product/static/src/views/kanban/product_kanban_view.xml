<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t
        t-name="muk_product.KanbanView.Buttons"
        t-inherit="web.KanbanView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="." position="inside">
            <button
                type="button"
                class="btn btn-secondary mk_button_product_search"
                t-on-click="() => this.actionService.doAction('muk_product.action_product_search')"
            >
                Search
            </button>
        </xpath>
    </t>

</templates>
