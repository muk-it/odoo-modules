<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="webclient_bootstrap" name="Web Client" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-call='web.layout']" position="attributes">
            <attribute
                name="body_classname.f"
                add="mk_sidebar_type_{{ request.env.user.sidebar_type or 'large' }}"
                separator=" "
            />
        </xpath>
    </template>

</odoo>
