<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai_schedule</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="muk_ai.view_res_config_settings_form"/>
		<field name="arch" type="xml">
			<xpath expr="//div[@id='msg_module_muk_ai_schedule']" position="replace">
				<div
					class="content-group mt16"
					invisible="not module_muk_ai_schedule"
					id="msg_module_muk_ai_schedule"
				>
					<div class="row">
						<div class="o_light_label">
							<label
								class="col-6 col-sm-4 col-md-2 col-lg-4"
								string="Max waits"
								for="ai_max_waits"
							/>
							<field name="ai_max_waits" class="w-25 text-center" nolabel="1"/>
							<span class="col-auto ms-2">per Chat</span>
						</div>
					</div>
				</div>
			</xpath>
		</field>
	</record>

</odoo>
