<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai_schedule</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="muk_ai.view_res_config_settings_form"/>
		<field name="arch" type="xml">
			<xpath expr="//setting[@id='muk_ai_turn_cost_limit']" position="after">
				<setting id="wait_limit">
					<label string="Wait Limit" for="ai_max_waits"/>
					<div class="text-muted">
						How often one chat may pause itself to wait before it has to finish.
					</div>
					<div class="content-group mt16">
						<div class="row">
							<div class="o_light_label">
								<label
									class="fw-bold col-6 col-sm-4 col-md-2 col-lg-4"
									string="Max waits"
									for="ai_max_waits"
								/>
								<field name="ai_max_waits" class="w-25 text-center" nolabel="1"/>
								<span class="col-auto ms-2">per Chat</span>
							</div>
						</div>
					</div>
				</setting>
			</xpath>
		</field>
	</record>

</odoo>
