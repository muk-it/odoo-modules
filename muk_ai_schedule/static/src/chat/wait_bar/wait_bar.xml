<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="muk_ai_schedule.WaitBar">
        <div t-if="this.plan" class="mk_wait_bar d-flex align-items-center gap-2">
            <i class="oi flex-shrink-0 text-primary" data-icon="schedule"/>
            <span class="d-flex flex-column flex-grow-1 min-w-0">
                <span class="mk_wait_bar_line text-truncate" t-out="this.line"/>
                <span
                    class="mk_wait_bar_note small text-muted text-truncate"
                    t-out="this.plan.note"
                />
            </span>
            <t t-if="!this.props.session.readonly">
                <button
                    class="btn btn-sm btn-primary text-nowrap mk_wait_bar_wake"
                    type="button"
                    t-on-click="() => this.wake()"
                >
                    Wake now
                </button>
                <button
                    class="btn btn-sm btn-secondary text-nowrap mk_wait_bar_stop"
                    type="button"
                    t-on-click="() => this.props.session.stop()"
                >
                    Stop
                </button>
            </t>
        </div>
    </t>

</templates>
