<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="muk_ai.ChatComposer" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('mk_composer_host')]/*[1]" position="before">
            <WaitBar t-if="props.session" session="props.session"/>
        </xpath>
        <xpath expr="//textarea" position="attributes">
            <attribute name="t-att-placeholder">composerPlaceholder</attribute>
        </xpath>
    </t>

</templates>
