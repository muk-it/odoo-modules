<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="rule_muk_ai_schedule_owner" model="ir.rule">
            <field name="name">muk_ai.schedule: owner only (non-admin)</field>
            <field name="model_id" ref="model_muk_ai_schedule"/>
            <field name="domain_force">[('user_id','=',user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
        <record id="rule_muk_ai_schedule_admin" model="ir.rule">
            <field name="name">muk_ai.schedule: all schedules (administrators)</field>
            <field name="model_id" ref="model_muk_ai_schedule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
