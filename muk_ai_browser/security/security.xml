<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="rule_muk_ai_browser_permission_user" model="ir.rule">
		<field name="name">Users manage their own site permissions</field>
		<field name="model_id" ref="model_muk_ai_browser_permission"/>
		<field name="domain_force">[('user_id', '=', user.id)]</field>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		<field name="perm_read" eval="True"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>

	<record id="rule_muk_ai_browser_permission_user_global" model="ir.rule">
		<field name="name">Users read the site permissions for everyone</field>
		<field name="model_id" ref="model_muk_ai_browser_permission"/>
		<field name="domain_force">[('user_id', '=', False)]</field>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
		<field name="perm_read" eval="True"/>
		<field name="perm_write" eval="False"/>
		<field name="perm_create" eval="False"/>
		<field name="perm_unlink" eval="False"/>
	</record>

	<record id="rule_muk_ai_browser_permission_admin" model="ir.rule">
		<field name="name">Administrators manage every site permission</field>
		<field name="model_id" ref="model_muk_ai_browser_permission"/>
		<field name="domain_force">[(1, '=', 1)]</field>
		<field name="groups" eval="[(4, ref('base.group_system'))]"/>
		<field name="perm_read" eval="True"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>

</odoo>
