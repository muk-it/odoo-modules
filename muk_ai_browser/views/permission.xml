<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_browser_permission_list" model="ir.ui.view">
		<field name="name">muk_ai_browser.permission.list</field>
		<field name="model">muk_ai_browser.permission</field>
		<field name="arch" type="xml">
			<list editable="bottom">
				<field name="user_id"/>
				<field name="origin"/>
				<field name="mode"/>
				<field name="create_date" optional="show"/>
			</list>
		</field>
	</record>

	<record id="action_browser_permission" model="ir.actions.act_window">
		<field name="name">Site Permissions</field>
		<field name="res_model">muk_ai_browser.permission</field>
		<field name="view_mode">list</field>
		<field name="view_id" ref="view_browser_permission_list"/>
	</record>

</odoo>
