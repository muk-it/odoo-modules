<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.muk_ai_browser</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//block[@name='integration']" position="after">
				<block title="MuK AI Browser" name="muk_ai_browser_settings">
					<setting
						id="browser_extension_id"
						string="Extension ID"
						help="Chrome extension id allowed to pair with this instance."
					>
						<field name="browser_extension_id" placeholder="abcdefghijklmnop"/>
					</setting>
					<setting
						id="browser_pairing_ttl"
						string="Pairing Code TTL"
						help="Lifetime of a one-time pairing code before it expires."
					>
						<div class="content-group">
							<div class="row">
								<div class="o_light_label">
									<field name="browser_pairing_ttl" class="w-25 text-center" nolabel="1"/>
									<span class="col-auto ms-2">in Seconds</span>
								</div>
							</div>
						</div>
					</setting>
					<setting
						id="browser_risky_keywords"
						string="Risky Keywords"
						help="Comma-separated keywords that force an approval gate on a browser action."
					>
						<field name="browser_risky_keywords" placeholder="checkout,pay,buy,order,delete"/>
					</setting>
				</block>
			</xpath>
		</field>
	</record>

</odoo>
