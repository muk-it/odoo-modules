<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="rule_browser_device_user" model="ir.rule">
		<field name="name">Browser Device: own devices</field>
		<field name="model_id" ref="model_muk_ai_browser_device"/>
		<field name="domain_force">[('user_id', '=', user.id)]</field>
		<field name="groups" eval="[(4, ref('base.group_user'))]"/>
	</record>

	<record id="view_browser_device_list" model="ir.ui.view">
		<field name="name">muk_ai_browser.device.list</field>
		<field name="model">muk_ai_browser.device</field>
		<field name="arch" type="xml">
			<list create="false" edit="false" delete="true">
				<header>
					<button
						name="action_revoke"
						type="object"
						string="Revoke"
					/>
				</header>
				<field name="name"/>
				<field name="user_id"/>
				<field name="key_prefix"/>
				<field name="user_agent" optional="hide"/>
				<field name="last_seen_ip" optional="hide"/>
				<field name="last_seen"/>
				<field name="create_date"/>
				<field name="active" widget="boolean_toggle"/>
				<button
					name="action_revoke"
					type="object"
					string="Revoke"
					icon="fa-ban"
					invisible="not active"
				/>
			</list>
		</field>
	</record>

	<record id="action_browser_key" model="ir.actions.act_window">
		<field name="name">Connected Browsers</field>
		<field name="res_model">muk_ai_browser.device</field>
		<field name="view_mode">list,form</field>
		<field name="context">{'search_default_active': 1}</field>
		<field name="view_id" ref="view_browser_device_list"/>
	</record>

</odoo>
