<?xml version='1.0' encoding='UTF-8' ?>
<odoo>

    <record id="action_mail_failed" model="ir.actions.act_window">
        <field name="name">Failed Mails</field>
        <field name="path">mail-failed-emails</field>
        <field name="explanation">Opens the outgoing emails that could not be sent. Use this when the user wants to see why an email failed, or to send it again.</field>
        <field name="res_model">mail.mail</field>
        <field name="type">ir.actions.act_window</field>
        <field name="domain">[('state','=','exception')]</field>
        <field name="context">
            {
                'create': False,
                'edit': False,
                'bin_size': True,
            }
        </field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
