<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='user_default_rights']" position="inside">
                <setting
                    help="Preview Microsoft Office files (docx, xlsx, pptx) using the Microsoft Office Online viewer. Requires the Odoo instance to be publicly accessible."
                >
                    <field name="preview_office_enabled" string="MS Office Preview"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
