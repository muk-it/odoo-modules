<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting
                    id="muk_web_preview_office"
                    help="Preview Word, Excel and PowerPoint files with the Microsoft Office Online viewer. The database must be reachable from the internet."
                >
                    <field name="preview_office_enabled"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
