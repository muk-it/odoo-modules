<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

	<t
		t-name="muk_web_enterprise_theme.HomeMenu"
		t-inherit="web_enterprise.HomeMenu"
		t-inherit-mode="extension"
	>
		<xpath expr="//div" position="attributes">
			<attribute name="t-att-style">
				this.backgroundImageUrl and `background-image: url(${this.backgroundImageUrl});`
			</attribute>
		</xpath>
	</t>

</templates>
