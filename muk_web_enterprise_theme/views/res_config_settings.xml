<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_appsbar_form" model="ir.ui.view">
	    <field name="name">res.config.settings.form</field>
	    <field name="model">res.config.settings</field>
	    <field name="inherit_id" ref="muk_web_appsbar.view_res_config_settings_form"/>
	    <field name="arch" type="xml">
	    	<xpath expr="//field[@name='appbar_image']/../.." position="attributes">
	    		<attribute name="invisible">1</attribute>
	    	</xpath>
	    </field>
	</record>

	<record id="view_res_config_settings_colors_form" model="ir.ui.view">
	    <field name="name">res.config.settings.form</field>
	    <field name="model">res.config.settings</field>
	    <field name="inherit_id" ref="muk_web_colors.view_res_config_settings_form"/>
	    <field name="arch" type="xml">
	    	<xpath expr="//block[@id='branding_settings']" position="attributes">
	    		<attribute name="title">Backend Theme</attribute>
	    	</xpath>
	    	<xpath expr="//field[@name='color_primary_light']/.." position="after">
             	<div class="w-50 row">
                    <label for="color_appbar_text_theme_light" string="Apps Text" class="d-block w-75 py-2"/>
                    <field name="color_appbar_text_theme_light" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
             	<div class="w-50 row">
                    <label for="color_appbar_active_theme_light" string="Apps Active" class="d-block w-75 py-2"/>
                    <field name="color_appbar_active_theme_light" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
             	<div class="w-50 row">
                    <label for="color_appbar_background_theme_light" string="Background" class="d-block w-75 py-2"/>
                    <field name="color_appbar_background_theme_light" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
	    	</xpath>
	    	<xpath expr="//field[@name='color_primary_dark']/.." position="after">
             	<div class="w-50 row">
                    <label for="color_appbar_text_theme_dark" string="Apps Text" class="d-block w-75 py-2"/>
                    <field name="color_appbar_text_theme_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
             	<div class="w-50 row">
                    <label for="color_appbar_active_theme_dark" string="Apps Active" class="d-block w-75 py-2"/>
                    <field name="color_appbar_active_theme_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
             	<div class="w-50 row">
                    <label for="color_appbar_background_theme_dark" string="Background" class="d-block w-75 py-2"/>
                    <field name="color_appbar_background_theme_dark" class="d-block w-25 p-0 m-0" widget="color"/>
                </div>
	    	</xpath>
	    	<xpath expr="//block[@id='branding_settings']" position="inside">
    			<setting
    				string="Light Mode Background Image"
    				company_dependent="1"
    				help="Set the background image for the apps menu"
    			>
    				<field name="theme_background_image_light" widget="image" class="ml-4 w-75 bg-transparent"/>
                </setting>
    			<setting
    				string="Dark Mode Background Image"
    				company_dependent="1"
    				help="Set the background image for the apps menu"
    			>
    				<field name="theme_background_image_dark" widget="image" class="ml-4 w-75 bg-transparent"/>
                </setting>
	    		<setting string="AppsBar" company_dependent="1" help="Set your own Logo for the appsbar">
	    			<div class="w-50 row">
                    	<field name="appbar_image" widget="image" class="oe_avatar bg-transparent"/>
                    </div>
                </setting>
                <setting string="Favicon" company_dependent="1" help="Set your own favicon">
	    			<div class="w-50 row">
                    	<field name="theme_favicon" widget="image" class="oe_avatar bg-transparent"/>
                    </div>
                </setting>
	    	</xpath>
	    	<xpath expr="//block[@id='branding_settings']" position="after">
                <block title="Theme Extensions" id="muk_web_theme_extensions">
                    <setting
                        id="muk_web_theme_addon_list_search"
                        string="List Search"
                        help="Filter list views right below the column headers."
                    >
                        <field
                            name="module_muk_web_list_search"
                            widget="module_link"
                        />
                    </setting>
                    <setting
                        id="muk_web_theme_addon_list_custom"
                        string="List Custom"
                        help="Customize list views, store and share favorites."
                    >
                        <field
                            name="module_muk_web_list_custom"
                            widget="module_link"
                        />
                    </setting>
                    <setting
                        id="muk_web_theme_addon_mail_search"
                        string="Global Search"
                        help="Global search across all models plus a full text search in messages."
                    >
                        <field
                            name="module_muk_mail_search"
                            widget="module_link"
                        />
                    </setting>
                    <setting
                        id="muk_web_theme_addon_list_split"
                        string="Split View"
                        help="Show the list and the form side by side."
                    >
                        <field
                            name="module_muk_web_list_split"
                            widget="module_link"
                        />
                    </setting>
                </block>
	    	</xpath>
	    </field>
	</record>

</odoo>
