<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_Message_authorName')][1]" position="after">
            <span
                t-if="messageView and messageView.message and messageView.message.mcp_name"
                class="badge badge-info mr-1"
                style="font-size: 0.5rem;"
                t-attf-title="MCP: {{ messageView.message.mcp_name }}"
            >
                MCP
            </span>
        </xpath>
    </t>

</templates>
