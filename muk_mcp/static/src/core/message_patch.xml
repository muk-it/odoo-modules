<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-inherit="mail.Message" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('o-mail-Message-author')]/strong" position="after">
            <span t-if="message.mcp_key_name"
                class="badge text-bg-info ms-1 smaller"
                t-att-title="'MCP: ' + message.mcp_key_name"
            >MCP</span>
        </xpath>
    </t>

</templates>
