<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="1">

	<record id="res_groups_privilege_mcp" model="res.groups.privilege">
		<field name="name">MCP Server</field>
		<field name="sequence">100</field>
		<field name="category_id" ref="base.module_category_tools"/>
	</record>

	<record id="group_mcp_user" model="res.groups">
		<field name="name">User</field>
		<field name="sequence">10</field>
		<field name="privilege_id" ref="res_groups_privilege_mcp"/>
		<field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
		<field name="comment">
			Members of this group can connect to the MCP server
			and use tools marked as read-only.
		</field>
	</record>

	<record id="group_mcp_admin" model="res.groups">
		<field name="name">Administrator</field>
		<field name="sequence">20</field>
		<field name="privilege_id" ref="res_groups_privilege_mcp"/>
		<field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
		<field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
		<field name="comment">
			Members of this group can configure the MCP server,
			manage tools, and use all tool categories.
		</field>
	</record>

	<record id="rule_mcp_session_user" model="ir.rule">
		<field name="name">MCP Session: own sessions</field>
		<field name="model_id" ref="model_muk_mcp_session"/>
		<field name="domain_force">[('user_id', '=', user.id)]</field>
		<field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
		<field name="perm_read" eval="True"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>

	<record id="rule_mcp_session_admin" model="ir.rule">
		<field name="name">MCP Session: admin access</field>
		<field name="model_id" ref="model_muk_mcp_session"/>
		<field name="domain_force">[(1, '=', 1)]</field>
		<field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
		<field name="perm_read" eval="True"/>
		<field name="perm_write" eval="True"/>
		<field name="perm_create" eval="True"/>
		<field name="perm_unlink" eval="True"/>
	</record>

</odoo>
