<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_mcp_key_list" model="ir.ui.view">
		<field name="name">muk_mcp.key.list</field>
		<field name="model">muk_mcp.key</field>
		<field name="arch" type="xml">
			<list string="MCP API Keys">
				<field name="name"/>
				<field name="key_prefix"/>
				<field name="user_id"/>
				<field name="rate_limit"/>
				<field name="last_used"/>
				<field name="active"/>
			</list>
		</field>
	</record>

	<record id="view_mcp_key_form" model="ir.ui.view">
		<field name="name">muk_mcp.key.form</field>
		<field name="model">muk_mcp.key</field>
		<field name="arch" type="xml">
			<form string="MCP API Key">
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="Key Label"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="user_id"/>
							<field name="rate_limit"/>
						</group>
						<group>
							<field name="key_prefix" readonly="1"/>
							<field name="last_used" readonly="1"/>
							<field name="active"/>
						</group>
					</group>
					<notebook>
						<page string="Model Scopes" name="scopes">
							<field name="scope_ids">
								<list editable="bottom">
									<field name="model_name"/>
									<field name="perm_read"/>
									<field name="perm_write"/>
									<field name="perm_create"/>
									<field name="perm_unlink"/>
								</list>
							</field>
							<div class="text-muted mt-2">
								Leave empty to allow access to all models the user has permission for.
								Add scopes to restrict which models this key can access.
							</div>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_mcp_key" model="ir.actions.act_window">
		<field name="name">API Keys</field>
		<field name="res_model">muk_mcp.key</field>
		<field name="view_mode">list,form</field>
	</record>

</odoo>
