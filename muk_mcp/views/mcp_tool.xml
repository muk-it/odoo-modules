<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_mcp_tool_search" model="ir.ui.view">
		<field name="name">muk_mcp.tool.search</field>
		<field name="model">muk_mcp.tool</field>
		<field name="arch" type="xml">
			<search string="MCP Tools">
				<field name="name"/>
				<field name="description"/>
				<field name="category"/>
				<filter name="active" string="Active" domain="[('active', '=', True)]"/>
				<filter name="read" string="Read" domain="[('category', '=', 'read')]"/>
				<filter name="write" string="Write" domain="[('category', '=', 'write')]"/>
				<filter name="execute" string="Execute" domain="[('category', '=', 'execute')]"/>
				<separator/>
				<filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
			</search>
		</field>
	</record>

	<record id="view_mcp_tool_list" model="ir.ui.view">
		<field name="name">muk_mcp.tool.list</field>
		<field name="model">muk_mcp.tool</field>
		<field name="arch" type="xml">
			<list string="MCP Tools">
				<field name="sequence" widget="handle"/>
				<field name="name"/>
				<field name="description"/>
				<field name="category" widget="badge"
					decoration-success="category == 'read'"
					decoration-warning="category == 'write'"
					decoration-danger="category == 'execute'"
				/>
				<field name="read_only"/>
				<field name="active"/>
			</list>
		</field>
	</record>

	<record id="view_mcp_tool_form" model="ir.ui.view">
		<field name="name">muk_mcp.tool.form</field>
		<field name="model">muk_mcp.tool</field>
		<field name="arch" type="xml">
			<form string="MCP Tool">
				<sheet>
					<div class="oe_title">
						<h1>
							<field name="name" placeholder="Tool Name"/>
						</h1>
					</div>
					<group>
						<group>
							<field name="handler"/>
							<field name="category"/>
							<field name="read_only"/>
						</group>
						<group>
							<field name="sequence"/>
							<field name="active"/>
						</group>
					</group>
					<notebook>
						<page string="Description" name="description">
							<field name="description" placeholder="Describe what this tool does..."/>
						</page>
						<page string="Input Schema" name="schema">
							<field name="input_schema" widget="ace" options="{'mode': 'json'}"/>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_mcp_tool" model="ir.actions.act_window">
		<field name="name">MCP Tools</field>
		<field name="res_model">muk_mcp.tool</field>
		<field name="view_mode">list,form</field>
		<field name="context">{'search_default_active': 1}</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
				No MCP tools configured.
			</p>
			<p>
				Tools are automatically created when the module is installed.
				You can add custom tools here.
			</p>
		</field>
	</record>

</odoo>
