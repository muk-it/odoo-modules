<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_mcp_session_list" model="ir.ui.view">
		<field name="name">muk_mcp.session.list</field>
		<field name="model">muk_mcp.session</field>
		<field name="arch" type="xml">
			<list string="MCP Sessions" create="false">
				<field name="session_id"/>
				<field name="user_id"/>
				<field name="last_activity"/>
				<field name="create_date"/>
				<field name="active"/>
			</list>
		</field>
	</record>

	<record id="action_mcp_session" model="ir.actions.act_window">
		<field name="name">Sessions</field>
		<field name="res_model">muk_mcp.session</field>
		<field name="view_mode">list</field>
		<field name="context">{'active_test': false}</field>
	</record>

</odoo>
