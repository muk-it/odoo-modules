<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//block[@name='integration']" position="after">
				<block title="MCP Server" name="mcp_settings">
					<setting
						id="mcp_session_timeout"
						string="Session Timeout"
						help="Inactive sessions are cleaned up after this many hours."
					>
						<field name="mcp_session_timeout"/>
					</setting>
					<setting
						id="mcp_log_retention"
						string="Log Retention"
						help="Audit logs older than this many days are automatically deleted."
					>
						<field name="mcp_log_retention"/>
					</setting>
				</block>
			</xpath>
		</field>
	</record>

</odoo>
