<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_form" model="ir.ui.view">
		<field name="name">res.config.settings.form.mcp</field>
		<field name="model">res.config.settings</field>
		<field name="inherit_id" ref="base.res_config_settings_view_form"/>
		<field name="arch" type="xml">
			<xpath expr="//form" position="inside">
				<app string="MCP Server" name="muk_mcp">
					<block title="MCP Server" name="mcp_settings">
						<setting id="mcp_session_timeout" string="Session Timeout"
							help="Inactive sessions are cleaned up after this many hours.">
							<field name="mcp_session_timeout"/>
						</setting>
						<setting id="mcp_log_retention" string="Log Retention"
							help="Audit logs older than this many days are automatically deleted.">
							<field name="mcp_log_retention"/>
						</setting>
					</block>
				</app>
			</xpath>
		</field>
	</record>

</odoo>
