<odoo noupdate="1">
    <record id="cron_gc_oauth_codes" model="ir.cron">
        <field name="name">OAuth: purge authorization codes</field>
        <field name="model_id" ref="model_muk_mcp_oauth_code" />
        <field name="state">code</field>
        <field name="code">model._gc_codes()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
    <record id="cron_gc_oauth_tokens" model="ir.cron">
        <field name="name">OAuth: purge expired/revoked tokens</field>
        <field name="model_id" ref="model_muk_mcp_oauth_token" />
        <field name="state">code</field>
        <field name="code">model._gc_tokens()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_gc_oauth_clients" model="ir.cron">
        <field name="name">OAuth: archive idle DCR clients</field>
        <field name="model_id" ref="model_muk_mcp_oauth_client" />
        <field name="state">code</field>
        <field name="code">model._gc_clients()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
    </record>
</odoo>
