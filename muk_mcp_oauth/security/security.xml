<odoo noupdate="1">
    <record id="rule_oauth_token_user" model="ir.rule">
        <field name="name">OAuth Token: own connections</field>
        <field name="model_id" ref="model_muk_mcp_oauth_token" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="rule_oauth_token_admin" model="ir.rule">
        <field name="name">OAuth Token: admin access</field>
        <field name="model_id" ref="model_muk_mcp_oauth_token" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
