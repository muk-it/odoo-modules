#. module: muk_website_cookies_consent
#: model:muk_website_cookies_consent.cookie,description:muk_website_cookies_consent.cookie_odoo_recaptcha
msgid ""
"Set by reCAPTCHA when a form is protected against automated abuse, to tell a"
" person from a script."
msgstr "La establece reCAPTCHA cuando un formulario está protegido frente al abuso automatizado, para distinguir a una persona de un script."

#. module: muk_website_cookies_consent
#: model:muk_website_cookies_consent.cookie,necessity_justification:muk_website_cookies_consent.cookie_frontend_lang
msgid ""
"Set while the page is served, so the language you are reading is the one the"
" next page arrives in. Required to serve the site at all, and it holds a "
"language code and nothing else."
msgstr "Se establece al servir la página, para que el idioma que está leyendo sea aquel en el que llegue la siguiente. Es necesaria para servir el sitio y solo contiene un código de idioma."

#. module: muk_website_cookies_consent
#: model_terms:ir.ui.view,arch_db:muk_website_cookies_consent.view_cookie_category_form
msgid "Shown To Visitors"
msgstr "Mostrada a los visitantes"

#. module: muk_website_cookies_consent
#: model_terms:ir.ui.view,arch_db:muk_website_cookies_consent.view_cookie_service_form
msgid "Shown in place of the blocked embed."
msgstr "Se muestra en lugar del contenido incrustado bloqueado."

#. module: muk_website_cookies_consent
#: model:ir.model.fields,help:muk_website_cookies_consent.field_muk_website_cookies_consent_service__placeholder_text
msgid "Shown on the blocked element in place of the embed."
msgstr "Se muestra en el elemento bloqueado en lugar del contenido incrustado."

#. module: muk_website_cookies_consent
#: model:ir.model.fields,help:muk_website_cookies_consent.field_muk_website_cookies_consent_category__description
msgid "Shown to the visitor in the preference centre."
