#. module: muk_website_cookies_consent
#: model_terms:ir.actions.act_window,help:muk_website_cookies_consent.action_cookie_category
msgid ""
"Visitors decide per purpose. Only strictly necessary purposes may be on by "
"default."
msgstr "Los visitantes deciden por finalidad. Solo las finalidades estrictamente necesarias pueden estar activadas por defecto."

#. module: muk_website_cookies_consent
#: model_terms:ir.ui.view,arch_db:muk_website_cookies_consent.notice_copy
msgid "We ask before we track you"
msgstr "Le preguntamos antes de rastrearle"

#. module: muk_website_cookies_consent
#: model_terms:ir.ui.view,arch_db:muk_website_cookies_consent.cookie_policy
msgid ""
"We do not currently act on Do Not Track or Global Privacy Control signals. "
"Please use the choices above instead."
msgstr "Actualmente no aplicamos las señales Do Not Track ni Global Privacy Control.\n\t\t\t\tUtilice en su lugar las opciones anteriores."

#. module: muk_website_cookies_consent
#: model_terms:ir.ui.view,arch_db:muk_website_cookies_consent.cookie_policy
msgid ""
"We honour the Global Privacy Control signal. If your browser or an extension"
" sends it, we treat that as a refusal of every optional purpose and load "
"nothing that is not strictly necessary, whatever you may have chosen here "
"before."
msgstr "Respetamos la señal Global Privacy Control. Si su navegador o una extensión\n\t\t\t\tla envía, la tratamos como el rechazo de todas las finalidades opcionales y no cargamos\n\t\t\t\tnada que no sea estrictamente necesario, sea cual sea la elección que hiciera aquí antes."

