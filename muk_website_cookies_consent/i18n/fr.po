#: model:ir.model.fields,field_description:muk_website_cookies_consent.field_res_config_settings__cookie_log_consent
#: model:ir.model.fields,field_description:muk_website_cookies_consent.field_website__cookie_log_consent
msgid "Record Consent Proof"
msgstr "Enregistrer la preuve du consentement"

#. module: muk_website_cookies_consent
#: model:ir.model.fields,field_description:muk_website_cookies_consent.field_res_config_settings__cookie_log_ip
#: model:ir.model.fields,field_description:muk_website_cookies_consent.field_website__cookie_log_ip
#: model_terms:ir.ui.view,arch_db:muk_website_cookies_consent.res_config_settings_view_form
