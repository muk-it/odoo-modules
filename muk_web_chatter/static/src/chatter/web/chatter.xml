<?xml version="1.0" encoding="utf-8" ?>

<templates xml:space="preserve">

    <t
        t-name="muk_web_chatter.Chatter"
        t-inherit="mail.Chatter"
        t-inherit-mode="extension"
    >
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="replace">
            <button
                class="o-mail-Chatter-sendMessage btn text-nowrap"
                t-att-class="{
                    'btn-danger': !this.state.composerType,
                    'btn-primary': this.state.composerType === 'message',
                    'btn-secondary': this.state.composerType !== 'message',
                    'active': this.state.composerType === 'message',
                }"
                t-att-disabled="!this.state.thread.canPostMessage and this.thread().id"
                data-hotkey="m"
                t-on-click="() => (this.toggleComposer('message'), this.state.notifyInternalFollowers = false)"
            >
                External
            </button>
            <button
                class="o-mail-Chatter-sendInternal btn text-nowrap"
                t-att-class="{
                    'btn-success': !this.state.composerType,
                    'btn-primary': this.state.composerType === 'note' and this.state.notifyInternalFollowers,
                    'btn-secondary': !(this.state.composerType === 'note' and this.state.notifyInternalFollowers),
                    'active': this.state.composerType === 'note' and this.state.notifyInternalFollowers,
                }"
                t-att-disabled="!this.state.thread.canPostMessage and this.thread().id"
                t-on-click="() => (this.toggleComposer('note', { force: !this.state.notifyInternalFollowers }), this.state.notifyInternalFollowers = true)"
            >
                Internal
            </button>
        </xpath>
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="replace">
            <button
                class="o-mail-Chatter-logNote btn text-nowrap"
                t-att-class="{
                    'btn-primary active': this.state.composerType === 'note' and !this.state.notifyInternalFollowers,
                    'btn-secondary': this.state.composerType !== 'note' or this.state.notifyInternalFollowers,
                }"
                t-att-disabled="!this.state.thread.canPostMessage and this.thread().id"
                data-hotkey="shift+m"
                t-on-click="() => (this.toggleComposer('note', { force: this.state.notifyInternalFollowers }), this.state.notifyInternalFollowers = false)"
            >
                Note
            </button>
        </xpath>
        <xpath expr="//Composer" position="attributes">
            <attribute name="className">this.state.composerType === 'note' and !this.state.notifyInternalFollowers ? 'pt-4' : ''</attribute>
        </xpath>
        <xpath expr="//button[@t-on-click='this.onClickSearch']" position="after">
            <button
                class="btn btn-link px-1"
                aria-label="Show/Hide Notifications"
                title="Show/Hide Notifications"
                t-att-class="{ 'text-muted': !this.state.showNotificationMessages }"
                t-att-disabled="this.state.activePanel === this.CHATTER_PANEL.SEARCH"
                t-on-click="this.onClickNotificationsToggle"
            >
                <i class="oi oi-fw" data-icon="visibility" role="img"/>
            </button>
        </xpath>
    </t>

</templates>
